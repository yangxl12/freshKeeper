<view class="form-page page-shell">
  <view wx:if="{{errorMessage}}" class="feedback-error" role="alert">
    <text>{{errorMessage}}</text>
    <button wx:if="{{loadFailed}}" class="inline-retry" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:if="{{loading}}" class="form-loading">正在读取物品信息…</view>

  <block wx:elif="{{!loadFailed}}">
    <view class="form-sheet">
    <view class="form-section">
      <text class="form-section__eyebrow">01</text>
      <text class="form-section__title">基础信息</text>
      <view class="field">
        <text class="field-label">物品名称 <text class="required-mark">*</text></text>
        <input
          class="field-control"
          value="{{name}}"
          maxlength="40"
          placeholder="例如：鲜牛奶"
          placeholder-class="field-placeholder"
          data-field="name"
          bindinput="handleTextInput"
        />
      </view>

      <view class="field-row">
        <view class="field field--quantity">
          <text class="field-label">数量 <text class="required-mark">*</text></text>
          <input
            class="field-control"
            value="{{quantity}}"
            type="number"
            maxlength="4"
            data-field="quantity"
            bindinput="handleTextInput"
          />
        </view>
        <view class="field field--unit">
          <text class="field-label">单位 <text class="required-mark">*</text></text>
          <input
            class="field-control"
            value="{{unit}}"
            maxlength="8"
            placeholder="件"
            data-field="unit"
            bindinput="handleTextInput"
          />
        </view>
      </view>
    </view>

    <view class="form-section form-section--dated">
      <text class="form-section__eyebrow">02</text>
      <text class="form-section__title">到期信息 <text class="required-mark">*</text></text>
      <view class="mode-switch" role="tablist">
        <button
          class="mode-switch__item {{mode === 'direct' ? 'mode-switch__item--active' : ''}}"
          data-mode="direct"
          bindtap="handleModeChange"
          aria-selected="{{mode === 'direct'}}"
        >直接选到期日</button>
        <button
          class="mode-switch__item {{mode === 'shelf_life' ? 'mode-switch__item--active' : ''}}"
          data-mode="shelf_life"
          bindtap="handleModeChange"
          aria-selected="{{mode === 'shelf_life'}}"
        >按保质期计算</button>
      </view>

      <view wx:if="{{mode === 'direct'}}" class="field field--mode-content">
        <text class="field-label">到期日期 <text class="required-mark">*</text></text>
        <picker mode="date" value="{{expiryDate}}" end="2200-12-31" data-field="expiryDate" bindchange="handleDateChange">
          <view class="field-control date-control {{!expiryDate ? 'field-placeholder' : ''}}">
            <text>{{expiryDate || '选择日期'}}</text>
            <view class="line-icon line-icon--calendar date-control__icon" aria-hidden="true"></view>
          </view>
        </picker>
      </view>

      <block wx:else>
        <view class="field field--mode-content">
          <text class="field-label">生产日期 <text class="required-mark">*</text></text>
          <picker mode="date" value="{{productionDate}}" end="{{today}}" data-field="productionDate" bindchange="handleDateChange">
            <view class="field-control date-control {{!productionDate ? 'field-placeholder' : ''}}">
              <text>{{productionDate || '选择日期'}}</text>
              <view class="line-icon line-icon--calendar date-control__icon" aria-hidden="true"></view>
            </view>
          </picker>
        </view>
        <view class="field-row">
          <view class="field field--shelf-value">
            <text class="field-label">保质期 <text class="required-mark">*</text></text>
            <input
              class="field-control"
              value="{{shelfLifeValue}}"
              type="number"
              placeholder="例如：7"
              maxlength="5"
              data-field="shelfLifeValue"
              bindinput="handleTextInput"
            />
          </view>
          <view class="field field--shelf-unit">
            <text class="field-label">单位 <text class="required-mark">*</text></text>
            <picker mode="selector" range="{{shelfLifeOptions}}" range-key="label" value="{{shelfLifeUnitIndex}}" bindchange="handleShelfLifeUnitChange">
              <view class="field-control date-control">
                <text>{{shelfLifeOptions[shelfLifeUnitIndex].label}}</text>
                <view class="line-icon line-icon--chevron date-control__arrow" aria-hidden="true"></view>
              </view>
            </picker>
          </view>
        </view>
        <view class="expiry-preview {{expiryPreview ? 'expiry-preview--ready' : ''}}">
          <text class="expiry-preview__label">预计到期</text>
          <text class="expiry-preview__date">{{expiryPreview || '填写后自动计算'}}</text>
        </view>
      </block>
    </view>

    <view class="form-section">
      <text class="form-section__eyebrow">03</text>
      <text class="form-section__title">分类与提醒</text>
      <view class="field">
          <text class="field-label">分类 <text class="required-mark">*</text></text>
          <picker mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="handleCategoryChange">
            <view class="field-control date-control">
              <text>{{categoryOptions[categoryIndex].label}}</text>
              <view class="line-icon line-icon--chevron date-control__arrow" aria-hidden="true"></view>
            </view>
          </picker>
      </view>

      <view class="field">
        <text class="field-label">存放位置</text>
        <input
          class="field-control"
          value="{{storageLocation}}"
          maxlength="20"
          placeholder="如冰箱，床头柜，药箱等"
          placeholder-class="field-placeholder"
          data-field="storageLocation"
          bindinput="handleTextInput"
        />
      </view>

      <view class="field">
        <text class="field-label">提前提醒天数 <text class="required-mark">*</text></text>
        <view class="number-suffix-control">
          <input
            class="number-suffix-control__input"
            value="{{reminderLeadDays}}"
            type="number"
            maxlength="2"
            data-field="reminderLeadDays"
            bindinput="handleTextInput"
          />
          <text class="number-suffix-control__suffix">天</text>
        </view>
        <text class="field-help">保存物品不需要开启微信提醒，可稍后在详情页单独开启。</text>
      </view>
    </view>
    </view>

    <button class="primary-button save-button" disabled="{{saving}}" bindtap="save" hover-class="pressable--pressed">
      {{saving ? '正在保存…' : (restoring ? '确认重新入库' : (itemId ? '保存修改' : '加入库存'))}}
    </button>
  </block>
</view>

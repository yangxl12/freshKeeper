.form-page {
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.form-intro {
  padding: 4rpx 4rpx 32rpx;
}

.form-intro__step,
.form-intro__title,
.form-intro__description {
  display: block;
}

.form-intro__step {
  color: #61776e;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.form-intro__title {
  margin-top: 6rpx;
  color: #173b31;
  font-family: "Songti SC", "STSong", serif;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.28;
}

.form-intro__description {
  margin-top: 10rpx;
  color: #84918b;
  font-size: 23rpx;
}

.form-sheet {
  overflow: hidden;
  border: 2rpx solid #dde5e0;
  border-radius: 20rpx;
  background: #ffffff;
}

.form-section {
  padding: 32rpx 28rpx 2rpx;
  border-bottom: 2rpx solid #e5ebe7;
}

.form-section:last-child {
  border-bottom: 0;
}

.form-section--dated {
  background: #e8f2ed;
}

.form-section__title {
  display: block;
  margin-bottom: 26rpx;
  color: #173b31;
  font-size: 30rpx;
  font-weight: 650;
}

.required-mark {
  color: #b84a3e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 22rpx;
}

.field {
  min-width: 0;
  flex: 1;
  margin-bottom: 30rpx;
}

.field-row {
  display: flex;
  gap: 20rpx;
}

.field--quantity,
.field--unit {
  flex: 1;
}

.field--mode-content {
  margin-top: 28rpx;
}

.field--shelf-value {
  flex: 1.35;
}

.field--shelf-unit {
  flex: 1;
}

.mode-switch {
  display: flex;
  padding: 6rpx;
  border-radius: 16rpx;
  background: rgba(31, 93, 73, 0.09);
}

.mode-switch__item {
  min-height: 88rpx;
  flex: 1;
  padding: 0 10rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #607269;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.mode-switch__item--active {
  background: #ffffff;
  box-shadow: 0 5rpx 14rpx rgba(23, 59, 49, 0.08);
  color: #1f5d49;
  font-weight: 650;
}

.date-control {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-control__icon {
  width: 30rpx;
  height: 30rpx;
  color: #54766a;
}

.date-control__arrow {
  width: 26rpx;
  height: 26rpx;
  color: #84918b;
}

.date-control__arrow::before {
  top: 6rpx;
  left: 8rpx;
  width: 9rpx;
  height: 9rpx;
}

.expiry-preview {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -4rpx 0 30rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #b8c9c1;
  background: rgba(255, 255, 255, 0.46);
}

.expiry-preview--ready {
  border-left-color: #1f5d49;
  background: #ffffff;
}

.expiry-preview__label {
  color: #687970;
  font-size: 24rpx;
}

.expiry-preview__date {
  color: #173b31;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 27rpx;
  font-weight: 650;
}

.number-suffix-control {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 16rpx;
  background: #ffffff;
}

.number-suffix-control__input {
  height: 84rpx;
  flex: 1;
}

.number-suffix-control__suffix {
  color: #6e7d76;
  font-size: 25rpx;
}

.field-help {
  display: block;
  margin-top: 12rpx;
  color: #84918b;
  font-size: 22rpx;
}

.save-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 32rpx;
  z-index: 10;
  box-shadow: 0 12rpx 28rpx rgba(23, 59, 49, 0.18);
}

.form-loading {
  padding: 160rpx 0;
  color: #74817b;
  text-align: center;
}

.inline-retry {
  display: inline;
  min-height: 88rpx;
  margin-left: 12rpx;
  padding: 0;
  background: transparent;
  color: #9e3e34;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 88rpx;
}

@media (max-width: 340px) {
  .form-section {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .field-row {
    gap: 14rpx;
  }
}

<view class="quick-entry page-shell {{activeTab === 'quick' && quickTab === 'text' && popup !== 'recent' ? 'quick-entry--text' : ''}} {{activeTab === 'quick' && quickTab === 'recent' ? 'quick-entry--recent' : ''}}" style="{{activeTab === 'quick' && quickTab === 'text' && popup !== 'recent' && quickKeyboardHeight > 0 ? 'height: calc(100vh - ' + quickKeyboardHeight + 'px); padding-bottom: 12rpx;' : ''}}">
  <view class="entry-tabs" role="tablist">
    <button
      class="entry-tabs__item {{activeTab === 'quick' ? 'entry-tabs__item--active' : ''}}"
      data-tab="quick"
      bindtap="switchTab"
      aria-selected="{{activeTab === 'quick'}}"
    >快速录入</button>
    <button
      class="entry-tabs__item {{activeTab === 'full' ? 'entry-tabs__item--active' : ''}}"
      data-tab="full"
      bindtap="switchTab"
      aria-selected="{{activeTab === 'full'}}"
    >完整录入</button>
  </view>

  <block wx:if="{{activeTab === 'quick' && quickTab === 'recent'}}">
    <view class="recent-page__head">
      <text class="recent-page__title">最近录入</text>
      <button class="recent-page__close" bindtap="closeRecentList" aria-label="关闭最近录入">×</button>
    </view>
      <view wx:if="{{loading}}" class="quick-entry__loading">正在准备快速录入…</view>
      <view wx:if="{{loadingError}}" class="quick-entry__notice" role="alert">
        <text>{{loadingError}}</text>
        <button class="notice-retry" bindtap="retryRecent">重试</button>
      </view>

      <block wx:if="{{!loading && features.recent}}">
        <view wx:if="{{recentProfiles.length}}" class="recent-section">
          <view class="recent-list">
            <button wx:for="{{recentProfiles}}" wx:key="name" wx:for-item="profile" class="recent-item" data-index="{{index}}" bindtap="selectRecent" hover-class="recent-item--pressed">
              <view class="recent-item__content">
                <text class="recent-item__name">{{profile.name}}</text>
                <text class="recent-item__meta">{{profile.quantity}}{{profile.unit}}<text wx:if="{{profile.storageLocation}}"> · {{profile.storageLocation}}</text></text>
              </view>
              <view class="line-icon line-icon--chevron-right recent-item__arrow" aria-hidden="true"></view>
            </button>
          </view>
        </view>
        <view wx:else class="quick-entry__empty">还没有录入记录，先用一句话或直接完整录入。</view>
  </block>

  <view wx:if="{{fullMounted}}" style="display: {{activeTab === 'full' ? 'block' : 'none'}};">
    <item-form-sheet id="fullForm" source="quick-entry" bind:saved="handleFullFormSaved" />
  </view>

  <view wx:if="{{activeTab === 'quick' && (quickTab === 'text' || popup === 'recent')}}" class="{{popup === 'recent' ? 'entry-sheet' : 'inline-entry'}}">
    <view wx:if="{{popup === 'recent'}}" class="entry-sheet__mask" bindtap="requestClosePopup" />
    <view class="{{popup === 'recent' ? 'entry-sheet__panel' : 'inline-entry__panel'}}">
      <view wx:if="{{popup === 'recent'}}" class="entry-sheet__head">
        <text class="entry-sheet__title">添加物品</text>
      </view>

        <form wx:if="{{popup !== 'recent' && (features.text || features.voice || features.datePhoto)}}" class="quick-input-card" bindsubmit="handleGenerateSubmit">
          <view class="quick-input-card__head">
            <button wx:if="{{features.recent}}" class="recent-entry-button" bindtap="openRecentList" hover-class="recent-entry-button--pressed">从最近录入添加</button>
          </view>
          <view class="quick-input-row">
            <view class="quick-input-wrap">
              <textarea wx:if="{{features.text || features.voice}}" class="quick-input" name="quickText" value="{{inputText}}" focus="{{quickInputFocused}}" maxlength="500" adjust-position="{{false}}" hold-keyboard="{{true}}" bindfocus="handleQuickInputFocus" bindkeyboardheightchange="handleQuickKeyboardHeightChange" bindblur="handleQuickInputBlur" placeholder="例如：牛奶2盒，3天后到期，放冰箱" placeholder-class="field-placeholder" bindinput="handleQuickTextInput" />
              <view class="quick-input-tools">
                <button wx:if="{{features.voice}}" class="voice-button {{voiceState === 'recording' ? 'voice-button--recording' : ''}}" disabled="{{saving || recognitionState !== 'idle'}}" bindtap="toggleVoice" aria-label="{{voiceState === 'recording' ? '停止语音识别' : '开始语音识别'}}">
                  <view class="line-icon line-icon--microphone" aria-hidden="true"></view>
                </button>
                <button wx:if="{{features.datePhoto}}" class="photo-button {{photoStage !== 'idle' ? 'photo-button--active' : ''}}" disabled="{{saving || recognitionState !== 'idle'}}" bindtap="chooseDatePhoto" aria-label="{{photoStage !== 'idle' ? '收起拍日期' : '拍摄日期'}}">
                  <view class="line-icon line-icon--date-scan" aria-hidden="true"></view>
                </button>
                <button wx:if="{{features.text}}" class="quick-generate" disabled="{{saving || recognitionState !== 'idle'}}" form-type="submit" hover-class="pressable--pressed" aria-label="{{recognitionState === 'parsing' ? '正在生成' : '生成物品草稿'}}">
                  <view class="{{recognitionState === 'parsing' ? 'quick-generate__loading' : 'quick-generate__arrow'}}" aria-hidden="true"></view>
                </button>
              </view>
            </view>
          </view>
          <view wx:if="{{voiceState === 'recording'}}" class="quick-entry__notice">{{voiceSeconds}} / 30 秒 · {{voiceCancelling ? '松开取消录音' : '松开识别，移出按钮取消'}}</view>
          <text wx:if="{{features.voice && capabilities.voice}}" class="camera-help">麦克风仅用于识别本次录入内容，转写后可修改文字。</text>
          <view wx:if="{{recognitionState !== 'idle'}}" class="quick-entry__notice">{{recognitionState === 'transcribing' ? '正在转写语音…' : '正在识别…'}}<button bindtap="cancelRecognition">取消本次识别</button></view>
        </form>

      <scroll-view class="{{popup === 'recent' ? 'entry-sheet__body' : 'inline-entry__body'}}" scroll-y>
        <view wx:if="{{photoStage !== 'idle'}}" class="date-camera-panel">
          <text class="section-heading__title">将包装上的日期喷码放入框内</text>
          <text class="camera-help">避开反光、阴影和弯曲边缘，让日期尽量占满画面。</text>
          <view wx:if="{{photoStage === 'camera' && !cameraError}}" class="camera-frame">
            <camera class="date-camera" mode="normal" device-position="back" flash="off" binderror="cameraFailed" />
            <cover-view class="camera-guide">对准生产日期、保质期或到期日</cover-view>
          </view>
          <image wx:if="{{photoStage === 'preview'}}" class="date-photo-preview" src="{{photoPreview}}" mode="aspectFit" />
          <view class="quick-actions">
            <button wx:if="{{photoStage === 'camera' && !cameraError}}" bindtap="takeDatePhoto">拍摄日期</button>
            <button wx:if="{{cameraError}}" bindtap="openPermissionSettings">前往设置</button>
            <button wx:if="{{photoStage === 'preview'}}" disabled="{{recognitionState !== 'idle'}}" bindtap="recognizePhoto">{{inputError ? '重试本次识别' : '识别这张照片'}}</button>
            <button wx:if="{{photoStage === 'preview'}}" disabled="{{recognitionState !== 'idle'}}" bindtap="retakePhoto">重拍</button>
            <button disabled="{{recognitionState !== 'idle'}}" bindtap="chooseAlbum">从相册选择</button>
          </view>
          <button class="manual-button" bindtap="closePhoto">返回手动填写</button>
        </view>

        <view wx:if="{{inputError}}" class="quick-entry__notice" role="alert">{{inputError}}</view>

        <view wx:if="{{drafts.length}}" class="draft-area">
          <view wx:for="{{drafts}}" wx:key="draftId" wx:for-item="draft" wx:for-index="draftIndex" class="draft-card draft-card--{{draft.status}}">
            <view wx:if="{{popup !== 'recent'}}" class="draft-card__status-row">
              <text class="draft-card__status">{{draft.status === 'saved' ? '已加入库存' : (draft.status === 'saving' ? '正在保存' : (draft.status === 'failed' ? '保存失败，可重试' : (draft.issues.length ? '还需补充或确认' : '信息完整')))}}</text>
              <view class="draft-card__tools">
                <button wx:if="{{draft.status !== 'saving'}}" class="draft-heading__delete" data-index="{{draftIndex}}" bindtap="removeDraft" aria-label="删除草稿"><view class="line-icon line-icon--close" aria-hidden="true"></view></button>
              </view>
            </view>

            <view wx:if="{{draft.errorMessage}}" class="draft-card__error" role="alert">{{draft.errorMessage}}</view>
            <button wx:if="{{draft.status === 'failed'}}" disabled="{{saving}}" data-index="{{draftIndex}}" bindtap="retryDraft">重试这条草稿</button>
            <block wx:for="{{draft.issues}}" wx:key="message" wx:for-item="issue">
              <view wx:if="{{popup !== 'recent' || issue.code !== 'MISSING_EXPIRY'}}" class="draft-card__issue">{{issue.message}}</view>
            </block>

            <view class="field">
              <text class="field-label">物品名称 <text class="required-mark">*</text></text>
              <input class="field-control" focus="{{focusNameId === draft.draftId}}" disabled="{{saving || draft.status === 'saving' || draft.status === 'saved' || draft.status === 'failed'}}" value="{{draft.fields.name}}" maxlength="40" placeholder="例如：鲜牛奶" data-index="{{draftIndex}}" data-field="name" bindinput="handleTextInput" />
            </view>

            <view class="date-focus-block">
              <view class="field-label-row">
                <text class="field-label">到期信息 <text class="required-mark">*</text></text>
                <button wx:if="{{features.datePhoto && draft.status !== 'saving' && draft.status !== 'saved' && draft.status !== 'failed'}}" class="inline-photo-button" disabled="{{saving}}" data-index="{{draftIndex}}" bindtap="chooseDatePhoto" aria-label="拍摄日期"><view class="line-icon line-icon--date-scan" aria-hidden="true"></view></button>
              </view>
              <view class="mode-switch">
                <button class="mode-switch__item {{draft.fields.expiryInputMode === 'direct' ? 'mode-switch__item--active' : ''}}" disabled="{{saving || draft.status === 'saving' || draft.status === 'saved' || draft.status === 'failed'}}" data-index="{{draftIndex}}" data-mode="direct" bindtap="handleModeChange">直接选到期日</button>
                <button class="mode-switch__item {{draft.fields.expiryInputMode === 'shelf_life' ? 'mode-switch__item--active' : ''}}" disabled="{{saving || draft.status === 'saving' || draft.status === 'saved' || draft.status === 'failed'}}" data-index="{{draftIndex}}" data-mode="shelf_life" bindtap="handleModeChange">按保质期计算</button>
              </view>
              <view wx:if="{{draft.fields.expiryInputMode === 'direct'}}" class="field field--compact">
                <picker disabled="{{saving || draft.status === 'saving' || draft.status === 'saved' || draft.status === 'failed'}}" mode="date" value="{{draft.fields.expiryDate || today}}" end="2200-12-31" data-index="{{draftIndex}}" data-field="expiryDate" bindchange="handleDateChange">
                  <view class="field-control date-control {{!draft.fields.expiryDate ? 'field-placeholder' : ''}}"><text>{{draft.fields.expiryDate || '选择本批次到期日期'}}</text><view class="line-icon line-icon--calendar date-control__icon"></view></view>
                </picker>
              </view>
              <block wx:else>
                <view class="field field--compact">
                  <picker disabled="{{saving || draft.status === 'saving' || draft.status === 'saved' || draft.status === 'failed'}}" mode="date" value="{{draft.fields.productionDate || today}}" end="2200-12-31" data-index="{{draftIndex}}" data-field="productionDate" bindchange="handleDateChange">
                    <view class="field-control date-control {{!draft.fields.productionDate ? 'field-placeholder' : ''}}"><text>{{draft.fields.productionDate || '选择本批次生产日期'}}</text><view class="line-icon line-icon--calendar date-control__icon"></view></view>
                  </picker>
                </view>
                <view class="field-row">
                  <input class="field-control field-row__item" disabled="{{saving || draft.status === 'saving' || draft.status === 'saved' || draft.status === 'failed'}}" value="{{draft.fields.shelfLifeValue || ''}}" type="number" placeholder="保质期" data-index="{{draftIndex}}" data-field="shelfLifeValue" bindinput="handleTextInput" />
                  <picker class="field-row__item" disabled="{{saving || draft.status === 'saving' || draft.status === 'saved' || draft.status === 'failed'}}" mode="selector" range="{{shelfLifeOptions}}" range-key="label" data-index="{{draftIndex}}" bindchange="handleShelfLifeUnitChange"><view class="field-control date-control"><text>{{draft.fields.shelfLifeUnit === 'month' ? '个月' : (draft.fields.shelfLifeUnit === 'year' ? '年' : '天')}}</text><view class="line-icon line-icon--chevron date-control__arrow"></view></view></picker>
                </view>
              </block>
              <view wx:if="{{popup !== 'recent' || draft.fields.expiryDate || draft.fields.productionDate}}" class="expiry-summary"><text>预计到期</text><text class="expiry-summary__value">{{expirySummaries[draftIndex]}}</text></view>
              <view wx:if="{{expiredFlags[draftIndex]}}" class="draft-card__error">该物品已过期，请确认日期</view>
            </view>

            <view wx:if="{{draft.dateCandidates.length}}" class="candidate-list">
              <image wx:if="{{draft.evidence.kind === 'photo' && draft.evidence.localPath}}" class="date-photo-preview" src="{{draft.evidence.localPath}}" mode="aspectFit" />
              <view wx:for="{{draft.dateCandidates}}" wx:key="rawText" wx:for-item="candidate" wx:for-index="candidateIndex" class="candidate-item">
                <view class="candidate-item__text"><text>{{candidate.rawText || '识别日期'}}</text><text>{{candidate.date || '日期不完整'}}</text></view>
                <view wx:if="{{candidate.complete && !draft.dateInvalid && draft.status !== 'saved' && draft.status !== 'failed' && draft.status !== 'saving' && (candidate.role === 'unknown' || draft.confirmationFields.length)}}" class="candidate-item__actions">
                  <button data-index="{{draftIndex}}" data-candidate="{{candidateIndex}}" data-role="expiry" bindtap="chooseCandidate">设为到期</button>
                  <button data-index="{{draftIndex}}" data-candidate="{{candidateIndex}}" data-role="production" bindtap="chooseCandidate">设为生产</button>
                </view>
              </view>
            </view>
            <button wx:if="{{draft.confirmationFields.length && draft.status !== 'saved'}}" class="manual-button" data-index="{{draftIndex}}" bindtap="confirmFallback">确认已修正的非日期字段</button>
            <button class="draft-card__summary" data-index="{{draftIndex}}" bindtap="toggleDetails">
              <text>{{draftSummaries[draftIndex]}}</text><text>{{draft.expanded ? '收起' : '更多信息'}}</text>
            </button>
            <view wx:if="{{draft.expanded}}" class="draft-card__details">
              <view class="field-row">
                <view class="field field-row__item"><text class="field-label">数量</text><input disabled="{{saving || draft.status === 'saved' || draft.status === 'failed'}}" class="field-control" value="{{draft.fields.quantity || ''}}" type="number" data-index="{{draftIndex}}" data-field="quantity" bindinput="handleTextInput" /></view>
                <view class="field field-row__item"><text class="field-label">单位</text><input disabled="{{saving || draft.status === 'saved' || draft.status === 'failed'}}" class="field-control" value="{{draft.fields.unit}}" data-index="{{draftIndex}}" data-field="unit" maxlength="8" bindinput="handleTextInput" /></view>
              </view>
              <view class="field"><text class="field-label">分类</text><picker disabled="{{saving || draft.status === 'saved' || draft.status === 'failed'}}" mode="selector" range="{{categoryOptions}}" range-key="label" data-index="{{draftIndex}}" bindchange="handleCategoryChange"><view class="field-control date-control"><text>{{draft.fields.category === 'medicine' ? '药品' : (draft.fields.category === 'household' ? '日化' : (draft.fields.category === 'other' ? '其他' : '食品'))}}</text><view class="line-icon line-icon--chevron date-control__arrow"></view></view></picker></view>
              <view class="field"><text class="field-label">存放位置</text><input disabled="{{saving || draft.status === 'saved' || draft.status === 'failed'}}" class="field-control" value="{{draft.fields.storageLocation}}" placeholder="例如：冰箱" data-index="{{draftIndex}}" data-field="storageLocation" bindinput="handleTextInput" /></view>
              <view class="field"><text class="field-label">提前提醒天数</text><view class="number-suffix-control"><input disabled="{{saving || draft.status === 'saved' || draft.status === 'failed'}}" class="number-suffix-control__input" value="{{draft.fields.reminderLeadDays || 0}}" type="number" maxlength="2" data-index="{{draftIndex}}" data-field="reminderLeadDays" bindinput="handleTextInput" /><text>天</text></view></view>
            </view>
          </view>

          <view wx:if="{{saveSummary}}" class="quick-entry__notice">{{saveSummary}}</view>
        </view>

      </scroll-view>

      <view wx:if="{{drafts.length}}" class="entry-sheet__foot">
        <button wx:if="{{popup === 'recent'}}" class="entry-sheet__cancel" hover-class="entry-sheet__button--pressed" bindtap="requestClosePopup" disabled="{{saving}}">取消</button>
        <button class="primary-button entry-sheet__submit" hover-class="entry-sheet__button--pressed" disabled="{{saving || selectableCount === 0 || recognitionState !== 'idle'}}" bindtap="saveDrafts">{{saving ? '正在加入…' : (drafts.length > 1 ? '加入库存（' + selectableCount + '）' : '加入库存')}}</button>
      </view>
    </view>
  </view>
</view>

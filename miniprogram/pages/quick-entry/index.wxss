.quick-entry {
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

.quick-entry__loading {
  padding: 260rpx 0;
  color: #718078;
  text-align: center;
}

.quick-entry__heading,
.draft-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 44rpx;
}

.quick-entry__heading {
  display: block;
}

.quick-entry__kicker {
  display: block;
  color: #89a096;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
}

.quick-entry__title,
.draft-heading__title {
  display: block;
  margin-top: 10rpx;
  color: #173b31;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.15;
}

.quick-entry__description {
  display: block;
  max-width: 590rpx;
  margin-top: 18rpx;
  color: #718078;
  font-size: 26rpx;
}

.quick-entry__notice,
.quick-entry__empty {
  margin: 22rpx 0;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #cda365;
  background: #fff8ec;
  color: #87663b;
  font-size: 25rpx;
}

.quick-input-card {
  display: block;
  flex-shrink: 0;
  order: 3;
  margin: 20rpx 0 0;
  padding: 0;
  background: transparent;
}

.quick-input-row { display: flex; }
.quick-input-wrap { position: relative; width: 100%; }
.quick-input { box-sizing: border-box; width: 100%; height: 144rpx; padding: 12rpx 8rpx; border: 0; background: transparent; color: #173b31; font-size: 28rpx; line-height: 1.6; }
.quick-input-tools { display: flex; justify-content: flex-end; gap: 28rpx; align-items: center; padding-top: 12rpx; }
.voice-button, .photo-button { display: flex; box-sizing: border-box; width: 88rpx; height: 88rpx; flex-shrink: 0; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 50%; background: transparent; color: #1f5d49; }
.voice-button .line-icon, .photo-button .line-icon { width: 32rpx; height: 32rpx; }
.voice-button--recording { background: #b84a3e; color: #ffffff; }
.voice-button[disabled] { background: #f0f3f1; color: #aab6b1; }
.photo-button { display: flex; align-items: center; justify-content: center; gap: 10rpx; }
.photo-button .line-icon, .inline-photo-button .line-icon { width: 30rpx; height: 30rpx; }
.photo-button[disabled] { border-color: #e2e9e5; background: #f6f8f7; color: #aab6b1; }
.photo-button--active { background: #d7ebe0; color: #176348; box-shadow: 0 0 0 4rpx rgba(31, 93, 73, 0.12); }
.inline-photo-button[disabled] { background: #f3f6f4; color: #aab6b1; }
.feature-hint { display: block; margin-top: 14rpx; color: #9aa7a1; font-size: 22rpx; line-height: 1.5; }
.quick-actions { display: flex; gap: 16rpx; margin-top: 18rpx; }
.quick-generate { position: relative; display: flex; width: 88rpx; height: 88rpx; flex-shrink: 0; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 50%; background: #1f5d49; color: #ffffff; box-shadow: 0 6rpx 16rpx rgba(31, 93, 73, 0.18); }
.quick-generate[disabled] { background: #aab6b1; box-shadow: none; }
.quick-generate__arrow { position: relative; width: 36rpx; height: 36rpx; }
.quick-generate__arrow::before { position: absolute; top: 5rpx; left: 7rpx; width: 20rpx; height: 20rpx; border-top: 4rpx solid currentColor; border-left: 4rpx solid currentColor; transform: rotate(45deg); content: ""; }
.quick-generate__arrow::after { position: absolute; top: 4rpx; left: 17rpx; width: 4rpx; height: 32rpx; border-radius: 4rpx; background: currentColor; content: ""; }
.quick-generate__loading { width: 32rpx; height: 32rpx; border: 4rpx solid rgba(255, 255, 255, 0.35); border-top-color: #ffffff; border-radius: 50%; animation: quick-generate-spin 800ms linear infinite; }
@keyframes quick-generate-spin { to { transform: rotate(360deg); } }
.photo-preview { width: 100%; height: 220rpx; margin-top: 18rpx; border-radius: 14rpx; background: #eef2ef; }
.notice-retry { display: inline-block; margin-left: 18rpx; padding: 0 18rpx; border: 2rpx solid #d5b77f; border-radius: 10rpx; background: transparent; color: #7a582d; font-size: 23rpx; line-height: 52rpx; }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-heading__title {
  color: #53645d;
  font-size: 28rpx;
  font-weight: 650;
}

.section-heading__meta {
  color: #9aa7a1;
  font-size: 23rpx;
}

.recent-list {
  overflow: hidden;
  border: 2rpx solid #dce6e0;
  border-radius: 16rpx;
  background: #ffffff;
}

.recent-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #edf1ee;
  border-radius: 0;
  background: #ffffff;
  text-align: left;
}

.recent-item:last-child { border-bottom: 0; }
.recent-item--pressed { background: #f2f7f3; }
.recent-item__content { min-width: 0; }
.recent-item__name { display: block; overflow: hidden; color: #173b31; font-size: 30rpx; font-weight: 650; text-overflow: ellipsis; white-space: nowrap; }
.recent-item__meta { display: block; margin-top: 8rpx; color: #788880; font-size: 24rpx; }
.recent-item__arrow { color: #8da097; }

.manual-button {
  display: block;
  min-height: 84rpx;
  margin: 28rpx 0 0;
  border: 2rpx solid #cbd8d2;
  border-radius: 14rpx;
  background: transparent;
  color: #1f5d49;
  font-size: 27rpx;
  line-height: 80rpx;
}

.manual-button--lower { margin-top: 20rpx; }
.draft-heading__delete { width: 66rpx; height: 66rpx; margin: 8rpx 0 0; padding: 17rpx; border-radius: 50%; background: #ffffff; color: #788880; }
.draft-area { display: grid; gap: 14rpx; }
.draft-card { padding: 20rpx 20rpx 14rpx; border: 2rpx solid #cadbd2; border-radius: 14rpx; background: #ffffff; box-shadow: 0 8rpx 22rpx rgba(23, 59, 49, 0.06); }
.draft-card--needs_input { border-color: #dfcda9; }
.draft-card--failed { border-color: #dfb9b3; }
.draft-card__status-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.draft-card__tools { display: flex; align-items: center; gap: 8rpx; }
.draft-card__status { color: #1f5d49; font-size: 25rpx; font-weight: 650; }
.draft-card--needs_input .draft-card__status { color: #9a713a; }
.draft-card--failed .draft-card__status { color: #b84a3e; }
.draft-card__select { min-height: 54rpx; padding: 0 16rpx; border: 2rpx solid #cbd8d2; border-radius: 10rpx; background: #f7faf8; color: #1f5d49; font-size: 23rpx; line-height: 50rpx; }
.draft-card__select[disabled] { color: #aab6b1; }
.draft-card__error, .draft-card__issue { margin-bottom: 12rpx; color: #a34b40; font-size: 24rpx; }
.draft-card__issue { color: #98703b; }
.date-focus-block { margin: 4rpx -2rpx 26rpx; padding: 22rpx 20rpx 2rpx; border: 2rpx solid #d3e3da; border-radius: 14rpx; background: #f0f7f3; }
.field-label-row { display: flex; align-items: baseline; justify-content: space-between; }
.field-label-row__hint { color: #8a9d94; font-size: 21rpx; }
.field--compact { margin-bottom: 20rpx; }
.field-row { display: flex; gap: 16rpx; }
.field-row__item { min-width: 0; flex: 1; }
.mode-switch { display: flex; margin-bottom: 18rpx; padding: 5rpx; border-radius: 11rpx; background: rgba(31, 93, 73, 0.09); }
.mode-switch__item { min-height: 70rpx; flex: 1; padding: 0 8rpx; border-radius: 9rpx; background: transparent; color: #607269; font-size: 23rpx; line-height: 70rpx; }
.mode-switch__item--active { background: #ffffff; box-shadow: 0 4rpx 12rpx rgba(23, 59, 49, 0.08); color: #1f5d49; font-weight: 650; }
.date-control { display: flex; align-items: center; justify-content: space-between; }
.date-control__icon { color: #54766a; }
.date-control__arrow { width: 26rpx; height: 26rpx; color: #84918b; }
.date-control__arrow::before { top: 6rpx; left: 8rpx; width: 9rpx; height: 9rpx; }
.expiry-summary { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 0 20rpx; padding-top: 18rpx; border-top: 2rpx solid #dce9e1; color: #788880; font-size: 23rpx; }
.expiry-summary__value { color: #173b31; font-family: "DIN Alternate", "Arial Narrow", sans-serif; font-weight: 650; }
.inline-photo-button { padding: 0 14rpx; border-radius: 9rpx; background: #ffffff; color: #1f5d49; font-size: 22rpx; line-height: 50rpx; }
.inline-photo-button { display: inline-flex; align-items: center; gap: 6rpx; line-height: 50rpx; }
.candidate-list { margin-bottom: 20rpx; border: 2rpx solid #e3e9e5; border-radius: 12rpx; }
.candidate-item { padding: 16rpx; border-bottom: 2rpx solid #edf1ee; }
.candidate-item:last-child { border-bottom: 0; }
.candidate-item__text { display: flex; justify-content: space-between; gap: 16rpx; color: #5e7068; font-size: 23rpx; }
.candidate-item__actions { display: flex; gap: 12rpx; margin-top: 12rpx; }
.candidate-item__actions button { flex: 1; border-radius: 8rpx; background: #eef6f1; color: #1f5d49; font-size: 22rpx; line-height: 54rpx; }
.draft-card__summary { display: flex; width: 100%; justify-content: space-between; margin: 0; padding: 20rpx 0; border-top: 2rpx solid #edf1ee; border-radius: 0; background: transparent; color: #718078; font-size: 24rpx; line-height: 1.4; text-align: left; }
.draft-card__details { padding-top: 2rpx; }
.number-suffix-control { display: flex; align-items: center; box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 0 24rpx; border: 2rpx solid #dde5e0; border-radius: 16rpx; background: #ffffff; color: #6e7d76; }
.number-suffix-control__input { height: 84rpx; flex: 1; }
.date-camera-panel { margin: 24rpx 0; padding: 24rpx; border-radius: 18rpx; background: #eaf2ed; }
.camera-help { display: block; margin: 16rpx 0; font-size: 25rpx; color: #53645d; }
.camera-frame { position: relative; overflow: hidden; border: 4rpx solid #176348; border-radius: 16rpx; }
.date-camera { width: 100%; height: 400rpx; }
.camera-guide { position: absolute; bottom: 20rpx; left: 20rpx; padding: 12rpx; background: #173b31; color: white; font-size: 24rpx; }
.date-photo-preview { display: block; width: 100%; height: 320rpx; margin: 16rpx 0; }
.date-camera-panel .quick-actions { flex-wrap: wrap; }
.date-camera-panel button { font-size: 25rpx; }

.entry-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 34rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: rgba(31, 93, 73, 0.09);
}

.entry-tabs__item {
  min-height: 84rpx;
  flex: 1;
  border-radius: 12rpx;
  background: transparent;
  color: #607269;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.entry-tabs__item--active {
  background: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(23, 59, 49, 0.1);
  color: #1f5d49;
}

.quick-tabs { display: flex; gap: 32rpx; margin: -6rpx 0 28rpx; border-bottom: 2rpx solid #dce6e0; }
.quick-tabs__item { margin: 0; padding: 0 0 18rpx; border-radius: 0; border-bottom: 4rpx solid transparent; background: transparent; color: #788880; font-size: 27rpx; line-height: 48rpx; }
.quick-tabs__item--active { border-bottom-color: #1f5d49; color: #1f5d49; font-weight: 650; }
.inline-entry { position: static; z-index: auto; pointer-events: auto; }
.quick-entry--text { display: flex; height: 100vh; min-height: 0; flex-direction: column; overflow: hidden; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.quick-entry--text .entry-tabs, .quick-entry--text .quick-tabs { flex-shrink: 0; }
.quick-entry--text .inline-entry { flex: 1; min-height: 0; }
.inline-entry__panel { display: flex; box-sizing: border-box; height: 100%; min-height: 0; flex-direction: column; }
.inline-entry__body { width: 100%; height: 0; min-height: 0; flex: 1; }
.inline-entry__panel > .entry-sheet__foot { flex-shrink: 0; order: 2; }
.entry-sheet .draft-card { padding: 16rpx 4rpx 0; border: 0; background: transparent; box-shadow: none; }

.recent-scroll {
  max-height: 62vh;
}

.entry-sheet {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.entry-sheet__mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 32, 26, 0.45);
}

.entry-sheet__panel {
  position: relative;
  display: flex;
  flex-direction: column;
  max-height: 88vh;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #f5f6f2;
  box-shadow: 0 -12rpx 40rpx rgba(23, 59, 49, 0.16);
  animation: entry-sheet-up 220ms ease;
}

.entry-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6rpx 0 18rpx;
}

.entry-sheet__title {
  color: #173b31;
  font-size: 32rpx;
  font-weight: 700;
}

.entry-sheet__close {
  width: 66rpx;
  height: 66rpx;
  padding: 17rpx;
  border-radius: 50%;
  background: #e6ede9;
  color: #5c6c64;
}

.entry-sheet__body {
  flex: 1;
  min-height: 0;
  max-height: 68vh;
  margin: 0 -6rpx;
  padding: 0 6rpx;
}

.entry-sheet__foot {
  display: flex;
  gap: 16rpx;
  padding-top: 18rpx;
}

.entry-sheet__cancel {
  min-height: 92rpx;
  flex: 0 0 200rpx;
  border: 2rpx solid #cbd8d2;
  border-radius: 16rpx;
  background: #ffffff;
  color: #1f5d49;
  font-size: 29rpx;
  line-height: 88rpx;
}

.entry-sheet__submit {
  min-height: 92rpx;
  flex: 1;
  margin: 0;
  border-radius: 16rpx;
}

.line-icon--microphone::before {
  position: absolute;
  top: 2rpx;
  left: 11rpx;
  width: 16rpx;
  height: 25rpx;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
  content: "";
}

.line-icon--microphone::after {
  position: absolute;
  bottom: 3rpx;
  left: 5rpx;
  width: 28rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
  content: "";
}

.line-icon--scan { border: 3rpx solid currentColor; border-radius: 5rpx; }
.line-icon--scan::before, .line-icon--scan::after { position: absolute; width: 9rpx; height: 9rpx; border-color: currentColor; content: ""; }
.line-icon--scan::before { top: -3rpx; left: -3rpx; border-top: 3rpx solid; border-left: 3rpx solid; }
.line-icon--scan::after { right: -3rpx; bottom: -3rpx; border-right: 3rpx solid; border-bottom: 3rpx solid; }
.line-icon--date-scan { border: 3rpx solid currentColor; border-radius: 4rpx; }
.line-icon--date-scan::before { position: absolute; top: 7rpx; left: 4rpx; width: 18rpx; border-top: 3rpx solid currentColor; content: ""; }
.line-icon--date-scan::after { position: absolute; right: -5rpx; bottom: -5rpx; width: 12rpx; height: 12rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; content: ""; }

@keyframes entry-sheet-up {
  from {
    opacity: 0.6;
    transform: translateY(8%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

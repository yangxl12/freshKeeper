.quick-entry {
  background:
    radial-gradient(ellipse at 85% 0%, #e2f0e8 0%, transparent 40%),
    linear-gradient(180deg, #edf6f2, #f7faf9 540rpx, #f3f8f6);
}

.quick-entry--text {
  display: flex;
  box-sizing: border-box;
  height: 100vh;
  min-height: 0;
  flex-direction: column;
  overflow: hidden;
  padding-bottom: 0;
}

.quick-entry--recent {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.quick-stage {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
}

.quick-top {
  flex-shrink: 0;
  padding-bottom: 4rpx;
}

.quick-body {
  width: 100%;
  min-height: 0;
  flex: 1;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 有草稿时底部会出现固定操作条（约 160rpx 高）：必须让它这段高度，否则最后一张卡片被压住一截。 */
.quick-body--with-footer {
  padding-bottom: calc(204rpx + env(safe-area-inset-bottom));
}

.quick-entry__loading {
  padding: 260rpx 0;
  color: #7d8984;
  text-align: center;
}

.quick-entry__notice,
.quick-entry__empty {
  margin: 20rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff6e8;
  color: #866238;
  font-size: 24rpx;
}

.quick-entry__notice button {
  margin-left: 18rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(150, 108, 45, 0.1);
  color: #7a582d;
  font-size: 23rpx;
  line-height: 52rpx;
}

.quick-entry__empty {
  padding: 80rpx 30rpx;
  background: #ffffff;
  color: #929c97;
  text-align: center;
}

.quick-entry__tip {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 48rpx;
  padding: 40rpx 36rpx;
  border: 2rpx dashed #d3e2da;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.6);
  animation: tip-fade 320ms ease-out;
}

.quick-entry__tip-title {
  color: #2e6a54;
  font-size: 28rpx;
  font-weight: 650;
}

.quick-entry__tip-text {
  color: #7e8c86;
  font-size: 24rpx;
  line-height: 1.7;
}

.entry-tabs {
  display: flex;
  flex-shrink: 0;
  gap: 4rpx;
  margin-bottom: 22rpx;
  padding: 5rpx;
  border: 2rpx solid #e4ece7;
  border-radius: 20rpx;
  background: rgba(236, 242, 238, 0.9);
}

.entry-tabs__item {
  min-height: 74rpx;
  flex: 1;
  border-radius: 15rpx;
  background: transparent;
  color: #7c8883;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 74rpx;
}

.entry-tabs__item--active {
  background: #ffffff;
  box-shadow: 0 3rpx 12rpx rgba(36, 65, 54, 0.08);
  color: #286d53;
}

.quick-input-card {
  display: block;
  box-sizing: border-box;
  flex-shrink: 0;
  margin: 0;
  padding: 20rpx 24rpx 18rpx;
  border: 2rpx solid rgba(40, 109, 83, 0.1);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(40, 66, 56, 0.06);
}

.recent-entry-button {
  position: relative;
  min-height: 60rpx;
  margin: 0 6rpx 0 0;
  padding: 0 20rpx;
  border: 0;
  border-radius: 999rpx;
  background: #eef6f1;
  color: #34745b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.recent-entry-button--pressed {
  background: #dcece3;
}

.recent-entry-button[disabled] {
  background: #f0f3f1;
  color: #aab6b1;
}

/* 原生 textarea 在 Android 上会把「文字/光标」按 line-height 居中、placeholder 行内居顶，
   line-height 给到 76rpx 时光标和占位文字就差出十几像素。这里改成与字号相当的行高，
   整行高度靠上下对称的内边距撑出来，两边行盒一致才对得齐。 */
.quick-input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 20rpx 6rpx;
  border: 0;
  background: transparent;
  color: #173b31;
  font-size: 28rpx;
  line-height: 36rpx;
}

.quick-input-placeholder {
  color: #a8afac;
  font-size: 28rpx;
  line-height: 36rpx;
}

.quick-input-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #f0f4f1;
}

.quick-input-tools__group {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 14rpx;
}

.tool-button {
  display: flex;
  box-sizing: border-box;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #f3f6f4;
  color: #527066;
}

.tool-button--recording {
  background: #b84a3e;
  color: #ffffff;
  animation: recording-pulse 1200ms ease-in-out infinite;
}

.tool-button--active {
  background: #dcece3;
  color: #286d53;
  box-shadow: 0 0 0 4rpx rgba(40, 109, 83, 0.1);
}

.tool-button[disabled] {
  background: #f0f3f1;
  color: #aab6b1;
}

.quick-generate {
  display: flex;
  box-sizing: border-box;
  min-height: 68rpx;
  align-items: center;
  gap: 12rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(115deg, #338b70, #28755e);
  box-shadow: 0 6rpx 16rpx rgba(40, 117, 94, 0.24);
  color: #ffffff;
}

.quick-generate[disabled] {
  background: #aab6b1;
  box-shadow: none;
}

.quick-generate__label {
  font-size: 25rpx;
  font-weight: 600;
}

.quick-generate__arrow {
  position: relative;
  width: 26rpx;
  height: 26rpx;
}

.quick-generate__arrow::before {
  position: absolute;
  top: 3rpx;
  left: 5rpx;
  width: 13rpx;
  height: 13rpx;
  border-top: 3rpx solid currentColor;
  border-left: 3rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.quick-generate__arrow::after {
  position: absolute;
  top: 3rpx;
  left: 12rpx;
  width: 3rpx;
  height: 22rpx;
  border-radius: 3rpx;
  background: currentColor;
  content: "";
}

.quick-generate__loading {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: quick-generate-spin 800ms linear infinite;
}

.feature-hint {
  display: block;
  margin-top: 12rpx;
  color: #9aa7a1;
  font-size: 22rpx;
}

.notice-retry {
  display: inline-block;
  margin-left: 18rpx;
  padding: 0 18rpx;
  border: 2rpx solid #d5b77f;
  border-radius: 10rpx;
  background: transparent;
  color: #7a582d;
  font-size: 23rpx;
  line-height: 52rpx;
}

.recent-page__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 2rpx 22rpx;
}

.recent-page__title {
  color: #173b31;
  font-size: 32rpx;
  font-weight: 650;
}

.recent-page__close {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 0 5rpx;
  border-radius: 50%;
  background: #ecefec;
  color: #6f7c76;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
}

.recent-list {
  overflow: hidden;
  border: 2rpx solid #e6ebe8;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(40, 66, 56, 0.05);
}

.recent-item {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin: 0;
  padding: 22rpx 26rpx;
  border-bottom: 2rpx solid #edf0ee;
  border-radius: 0;
  background: #ffffff;
  text-align: left;
  line-height: 1.5;
}

.recent-item:last-child {
  border-bottom: 0;
}

.recent-item--pressed {
  background: #f2f6f3;
}

.recent-item__content {
  min-width: 0;
  flex: 1;
}

.recent-item__name {
  display: block;
  color: #173b31;
  font-size: 28rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.recent-item__meta {
  display: block;
  margin-top: 5rpx;
  color: #8b9691;
  font-size: 23rpx;
}

.recent-item__arrow {
  flex-shrink: 0;
  color: #95a19b;
}

.draft-area {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.draft-area__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 6rpx;
}

.draft-area__title {
  color: #30493f;
  font-size: 27rpx;
  font-weight: 650;
}

.draft-area__meta {
  color: #929c97;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.draft-card {
  position: relative;
  overflow: hidden;
  padding: 0 24rpx;
  border: 2rpx solid rgba(40, 109, 83, 0.08);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 26rpx rgba(40, 66, 56, 0.05);
  animation: draft-card-in 260ms ease-out;
}

.draft-card--tone-warn,
.draft-card--tone-alert {
  border-color: #eadfd2;
}

/* 整张卡片都是「进编辑」的热区，按下去要有反馈，不然用户不知道能点。 */
.draft-card--pressed {
  background: #fbfdfc;
  transform: scale(0.994);
}

.draft-card--saved {
  background: #fafcfb;
  opacity: 0.86;
}

.draft-card__head {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 12rpx;
  margin: 0;
  border-bottom: 2rpx solid #f0f3f1;
}

.draft-card__source {
  color: #8b9691;
  font-size: 22rpx;
}

.draft-card__ops {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 6rpx;
  margin-left: auto;
}

.draft-card__status {
  flex-shrink: 0;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 650;
}

.draft-card__status--ok {
  background: #e8f3ed;
  color: #2b7256;
}

.draft-card__status--warn {
  background: #faf0df;
  color: #9b6b2c;
}

.draft-card__status--alert {
  background: #fdecec;
  color: #a4473c;
}

.draft-card__status--busy {
  background: #eef2f0;
  color: #5f7069;
}

.draft-card__status--done {
  background: #e5f0eb;
  color: #2e7258;
}

.draft-card__ai {
  flex-shrink: 0;
  padding: 3rpx 12rpx;
  border: 2rpx solid #cfe4d9;
  border-radius: 999rpx;
  background: #edf7f1;
  color: #2b7256;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.draft-card__edit {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #eef6f1;
  color: #286d53;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.draft-card__edit .line-icon {
  width: 24rpx;
  height: 24rpx;
}

.draft-card__edit text {
  font-size: 23rpx;
}

.draft-card__remove {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #9ca6a1;
}

.draft-card__remove .line-icon {
  width: 26rpx;
  height: 26rpx;
}

.draft-card__remove--pressed {
  background: #edf1ee;
}

.draft-card__body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 20rpx 2rpx 22rpx;
}

.draft-card__name-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.draft-card__name {
  min-width: 0;
  color: #173b31;
  font-size: 31rpx;
  font-weight: 650;
  overflow-wrap: anywhere;
}

.draft-card__name--missing {
  color: #9b6b2c;
  font-weight: 500;
}

.draft-card__qty {
  flex-shrink: 0;
  color: #5f7069;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.draft-card__expiry {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.draft-card__expiry-date {
  color: #244138;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 28rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.draft-card__expiry-date--empty {
  color: #a1aaa5;
  font-family: inherit;
  font-size: 25rpx;
  font-weight: 500;
}

.draft-card__badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.draft-card__badge--fresh {
  background: #e8f3ed;
  color: #2b7256;
}

.draft-card__badge--soon {
  background: #fdf3e2;
  color: #a06e2d;
}

.draft-card__badge--expired {
  background: #fdecec;
  color: #a4473c;
}

.draft-card__badge--empty {
  background: #f0f3f1;
  color: #a1aaa5;
}

.draft-card__loc {
  color: #7e8984;
  font-size: 23rpx;
}

.draft-card__loc::before {
  content: "📍 ";
  font-size: 20rpx;
}

.draft-card__hint {
  margin: 0 0 18rpx;
  padding: 15rpx 18rpx;
  border-radius: 12rpx;
  background: #f1f6f3;
  color: #5c6b64;
  font-size: 23rpx;
}

.draft-card__error {
  margin: 0 0 18rpx;
  padding: 15rpx 18rpx;
  border-radius: 12rpx;
  background: #fff1ee;
  color: #a4473c;
  font-size: 23rpx;
}

.draft-card__retry {
  min-height: 72rpx;
  margin: 0 0 18rpx;
  border: 2rpx solid #dfb9b3;
  border-radius: 14rpx;
  background: #fff7f5;
  color: #a4473c;
  font-size: 24rpx;
  line-height: 68rpx;
}

.draft-card__issues {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 0 0 18rpx;
}

.draft-card__issue {
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: #faf0df;
  color: #8f672f;
  font-size: 21rpx;
  line-height: 1.4;
}

.draft-card__issue--alert {
  background: #fdecec;
  color: #a4473c;
}

.quick-footer {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(40, 109, 83, 0.08);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(16rpx);
  animation: footer-up 240ms ease-out;
}

.quick-footer__hint {
  color: #a06e2d;
  font-size: 22rpx;
  text-align: center;
}

.quick-footer__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.quick-footer__more {
  flex-shrink: 0;
  min-height: 88rpx;
  margin: 0;
  padding: 0 30rpx;
  border: 2rpx solid #cfe0d8;
  border-radius: 20rpx;
  background: #f3faf6;
  color: #286d53;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.quick-footer__more[disabled] {
  background: #f3f5f3;
  color: #aab6b1;
  border-color: #e2e8e5;
}

.quick-footer__submit {
  min-width: 0;
  flex: 1;
  min-height: 88rpx;
  border-radius: 20rpx;
  background: linear-gradient(115deg, #338b70, #28755e);
  box-shadow: 0 8rpx 20rpx rgba(40, 117, 94, 0.26);
  color: #ffffff;
  font-size: 29rpx;
  line-height: 88rpx;
}

.quick-footer__submit[disabled] {
  background: #aab6b1;
  box-shadow: none;
}

/* 草稿编辑页：整屏表单，直接复用完整录入的 item-form-sheet。
   它自己的 save-bar 是 position:fixed，正好充当底部的「完成」主按钮。 */
.draft-editor {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  background: #f7faf8;
  animation: mask-in 160ms ease-out;
}

.draft-editor__head {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 2rpx solid #e8ece9;
  background: #ffffff;
}

.draft-editor__title {
  min-width: 0;
  flex: 1;
  color: #173b31;
  font-size: 30rpx;
  font-weight: 650;
}

.draft-editor__camera,
.draft-editor__close {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #eef4f0;
  color: #32735b;
  line-height: 1;
}

.draft-editor__camera .line-icon {
  width: 30rpx;
  height: 30rpx;
}

.draft-editor__camera[disabled] {
  background: #f0f3f1;
  color: #aab6b1;
}

.draft-editor__close {
  padding: 0 0 4rpx;
  background: #ecefec;
  color: #6f7c76;
  font-size: 38rpx;
  font-weight: 300;
}

.draft-editor__body {
  width: 100%;
  min-height: 0;
  box-sizing: border-box;
  flex: 1;
  padding: 24rpx 32rpx 0;
}
.manual-button {
  display: block;
  min-height: 84rpx;
  margin: 24rpx 0 0;
  border: 2rpx solid #dce5e0;
  border-radius: 14rpx;
  background: #f7faf8;
  color: #286d53;
  font-size: 25rpx;
  line-height: 80rpx;
}

.date-camera-panel {
  margin: 24rpx 0;
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 26rpx rgba(40, 66, 56, 0.05);
}

.section-heading__title {
  color: #354b42;
  font-size: 28rpx;
  font-weight: 650;
}

.camera-help {
  display: block;
  margin: 16rpx 0;
  color: #64766e;
  font-size: 24rpx;
}

.camera-frame {
  position: relative;
  overflow: hidden;
  border: 4rpx solid #286d53;
  border-radius: 16rpx;
}

.date-camera {
  width: 100%;
  height: 400rpx;
}

.camera-guide {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  left: 20rpx;
  padding: 12rpx;
  border-radius: 8rpx;
  background: rgba(23, 59, 49, 0.88);
  color: #ffffff;
  font-size: 23rpx;
  text-align: center;
}

.date-photo-preview {
  display: block;
  width: 100%;
  height: 320rpx;
  margin: 16rpx 0;
  border-radius: 14rpx;
  background: #f0f2f0;
}

.quick-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.quick-actions button {
  flex: 1;
  border-radius: 12rpx;
  background: #ffffff;
  color: #286d53;
  font-size: 24rpx;
  line-height: 68rpx;
}

.line-icon {
  position: relative;
  display: inline-block;
  box-sizing: border-box;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
  color: currentColor;
}

.line-icon--chevron::before,
.line-icon--chevron-right::before {
  position: absolute;
  top: 9rpx;
  left: 10rpx;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
}

.line-icon--chevron::before {
  transform: rotate(45deg);
}

.line-icon--chevron-right::before {
  transform: rotate(-45deg);
}

.line-icon--close::before,
.line-icon--close::after {
  position: absolute;
  top: 13rpx;
  left: 5rpx;
  width: 18rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.line-icon--close::before {
  transform: rotate(45deg);
}

.line-icon--close::after {
  transform: rotate(-45deg);
}

.line-icon--calendar {
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}

.line-icon--calendar::before {
  position: absolute;
  top: 7rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.line-icon--calendar::after {
  position: absolute;
  top: -5rpx;
  left: 7rpx;
  width: 14rpx;
  height: 7rpx;
  border-right: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
}

.line-icon--microphone::before {
  position: absolute;
  top: 2rpx;
  left: 9rpx;
  width: 14rpx;
  height: 23rpx;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
  content: "";
}

.line-icon--microphone::after {
  position: absolute;
  bottom: 3rpx;
  left: 4rpx;
  width: 24rpx;
  height: 15rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 18rpx 18rpx;
  content: "";
}

.line-icon--date-scan {
  border: 3rpx solid currentColor;
  border-radius: 4rpx;
}

.line-icon--date-scan::before {
  position: absolute;
  top: 7rpx;
  left: 4rpx;
  width: 18rpx;
  border-top: 3rpx solid currentColor;
  content: "";
}

.line-icon--date-scan::after {
  position: absolute;
  right: -5rpx;
  bottom: -5rpx;
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  content: "";
}

.line-icon--edit::before {
  position: absolute;
  top: 3rpx;
  left: 2rpx;
  box-sizing: border-box;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx 6rpx 6rpx 2rpx;
  content: "";
}

.line-icon--edit::after {
  position: absolute;
  right: -1rpx;
  bottom: -1rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 2rpx;
  background: currentColor;
  transform: rotate(45deg);
}

@keyframes quick-generate-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes draft-card-in {
  from {
    opacity: 0;
    transform: translateY(14rpx) scale(0.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes mask-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes footer-up {
  from {
    opacity: 0;
    transform: translateY(30%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes tip-fade {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes recording-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 rgba(184, 74, 62, 0.35);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(184, 74, 62, 0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .draft-card,
  .draft-editor,
  .quick-footer,
  .quick-entry__tip,
  .tool-button--recording,
  .quick-generate__loading {
    animation: none;
  }
}

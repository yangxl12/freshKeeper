.detail {
  padding-top: 26rpx;
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

.detail-loading {
  padding: 80rpx 0;
  color: #84918b;
  font-size: 26rpx;
  text-align: center;
}

.detail-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
  color: #9e3e34;
  font-size: 24rpx;
}

.detail-error button {
  min-width: 88rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

/* 顶部信息卡 */
.hero {
  box-sizing: border-box;
  padding: 30rpx 28rpx 26rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(23, 59, 49, 0.06);
}

.hero--danger { border-color: #eecdc8; }
.hero--urgent,
.hero--warning { border-color: #ecdcbe; }

.hero__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero__kind {
  color: #6b7a73;
  font-size: 23rpx;
}

.hero__pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f2ed;
  color: #1f5d49;
  font-size: 21rpx;
  font-weight: 650;
}

.hero--danger .hero__pill { background: #f8e9e6; color: #b84a3e; }
.hero--urgent .hero__pill,
.hero--warning .hero__pill { background: #f7ecdf; color: #9d6225; }

.hero__name {
  display: block;
  margin-top: 16rpx;
  color: #173b31;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.hero__stats {
  display: flex;
  align-items: stretch;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #eef2f0;
}

.hero__stat {
  flex: 1;
  min-width: 0;
}

.hero__stat + .hero__stat {
  padding-left: 20rpx;
  border-left: 2rpx solid #eef2f0;
}

.hero__stat-label {
  display: block;
  color: #84918b;
  font-size: 21rpx;
}

.hero__stat-value {
  display: block;
  margin-top: 6rpx;
  color: #173b31;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

/* 信息列表 */
.card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx 10rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(23, 59, 49, 0.045);
}

.card__title {
  display: block;
  margin-bottom: 8rpx;
  color: #173b31;
  font-size: 28rpx;
  font-weight: 700;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f1f5f3;
}

.info-row:last-child { border-bottom: 0; }

.info-row__label {
  color: #6b7a73;
  font-size: 25rpx;
}

.info-row__value {
  max-width: 60%;
  color: #173b31;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.note {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border: 2rpx dashed #d5dfda;
  border-radius: 20rpx;
  background: #ffffff;
}

.note__title {
  display: block;
  color: #173b31;
  font-size: 28rpx;
  font-weight: 700;
}

.note__copy {
  display: block;
  margin-top: 8rpx;
  color: #6b7a73;
  font-size: 24rpx;
}

/* 底部操作条 */
.action-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 900;
  display: flex;
  align-items: center;
  padding: 10rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(23, 59, 49, 0.14);
}

.action-bar__button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 16rpx;
  background: transparent;
}

.action-bar__button + .action-bar__button {
  border-left: 2rpx solid #eef2f0;
}

.action-bar__button--pressed { background: #f1f6f3; }

.action-bar__text {
  color: #1f5d49;
  font-size: 27rpx;
  font-weight: 650;
}

.action-bar__text--danger { color: #b84a3e; }

/* 提醒弹窗 */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 950;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(18, 38, 32, 0.38);
}

.sheet {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx 28rpx 20rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 50rpx rgba(18, 38, 32, 0.2);
}

.sheet__title {
  display: block;
  color: #173b31;
  font-size: 32rpx;
  font-weight: 700;
}

.sheet__subtitle {
  display: block;
  margin-top: 6rpx;
  color: #84918b;
  font-size: 23rpx;
}

.sheet__copy {
  display: block;
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f5f9f7;
  color: #53645d;
  font-size: 24rpx;
  line-height: 1.6;
}

.sheet__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.sheet__button {
  flex: 1;
  margin: 0;
  min-height: 88rpx;
  line-height: 88rpx;
}

.sheet__close {
  width: 100%;
  height: 88rpx;
  margin: 14rpx 0 0;
  padding: 0;
  background: transparent;
  color: #6b7a73;
  font-size: 27rpx;
  line-height: 88rpx;
}

@media (max-width: 340px) {
  .hero__stat-value { font-size: 26rpx; }
  .action-bar__text { font-size: 24rpx; }
}

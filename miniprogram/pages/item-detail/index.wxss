.detail {
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.detail-loading {
  padding: 180rpx 0;
  color: #74817b;
  text-align: center;
}

.detail-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
  color: #9e3e34;
  font-size: 23rpx;
}

.detail-error button {
  height: 88rpx;
  margin: 0 0 0 14rpx;
  padding: 0 10rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  margin: 4rpx 0 42rpx;
  padding: 30rpx 30rpx 28rpx;
  border: 2rpx solid #dde5e0;
  border-top: 10rpx solid #1f5d49;
  border-radius: 20rpx;
  background: #ffffff;
}

.detail-hero::after {
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 72rpx;
  height: 72rpx;
  background: #f5f6f2;
  content: "";
  transform: rotate(45deg);
}

.detail-hero--danger {
  border-top-color: #b84a3e;
}

.detail-hero--urgent,
.detail-hero--warning {
  border-top-color: #c8792b;
}

.detail-hero__topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-right: 16rpx;
}

.detail-hero__label {
  color: #1f5d49;
  font-size: 22rpx;
  font-weight: 650;
  letter-spacing: 0.12em;
}

.detail-hero__kind {
  color: #84918b;
  font-size: 22rpx;
}

.detail-hero__name {
  display: block;
  margin-top: 24rpx;
  overflow-wrap: break-word;
  color: #173b31;
  font-family: "Songti SC", "STSong", serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.22;
}

.detail-hero__status {
  display: block;
  margin-top: 12rpx;
  color: #1f5d49;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 36rpx;
  font-weight: 700;
}

.detail-hero__status--danger {
  color: #b84a3e;
}

.detail-hero__status--urgent,
.detail-hero__status--warning {
  color: #b46d27;
}

.detail-hero__expiry {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx dashed #cbd8d2;
}

.detail-hero__expiry-label {
  color: #718079;
  font-size: 23rpx;
}

.detail-hero__expiry-date {
  color: #173b31;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.detail-section--plain {
  margin-bottom: 42rpx;
}

.detail-section__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.detail-section__title {
  display: block;
  color: #173b31;
  font-size: 30rpx;
  font-weight: 650;
}

.text-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 88rpx;
  margin: -24rpx 0 -24rpx 12rpx;
  padding: 0 10rpx;
  background: transparent;
  color: #1f5d49;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.text-action__icon {
  margin-right: 8rpx;
}

.detail-list {
  margin-top: 12rpx;
}

.detail-list__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80rpx;
  border-bottom: 2rpx solid #e5ebe7;
}

.detail-list__label {
  color: #84918b;
  font-size: 24rpx;
}

.detail-list__value {
  max-width: 420rpx;
  color: #3c5048;
  font-size: 26rpx;
  text-align: right;
  overflow-wrap: break-word;
}

.detail-list__value--strong {
  color: #173b31;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 30rpx;
  font-weight: 700;
}

.reminder-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 44rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #e8f2ed;
}

.reminder-strip__content {
  min-width: 0;
  flex: 1;
  margin-right: 20rpx;
}

.reminder-strip__heading {
  display: flex;
  align-items: baseline;
}

.reminder-strip__title {
  color: #173b31;
  font-size: 26rpx;
  font-weight: 650;
}

.reminder-strip__lead {
  margin-left: 12rpx;
  color: #60766d;
  font-size: 21rpx;
}

.reminder-strip__copy {
  display: block;
  margin-top: 6rpx;
  color: #64776e;
  font-size: 22rpx;
  line-height: 1.5;
}

.reminder-strip__button {
  width: 172rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 2rpx solid #1f5d49;
  border-radius: 14rpx;
  background: #ffffff;
  color: #1f5d49;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
}

.reminder-strip__button[disabled] {
  border-color: #cdd9d3;
  background: rgba(255, 255, 255, 0.58);
  color: #84918b;
}

.cancel-reminder {
  min-height: 48rpx;
  margin: 4rpx 0 -8rpx;
  padding: 0;
  background: transparent;
  color: #64776e;
  font-size: 21rpx;
  line-height: 48rpx;
  text-align: left;
}

.stock-actions {
  margin-bottom: 44rpx;
}

.stock-actions__primary,
.stock-actions__decrement {
  margin-top: 20rpx;
}

.stock-actions__decrement {
  margin-top: 14rpx;
}

.danger-zone {
  padding-top: 28rpx;
  border-top: 2rpx solid #e3d8d5;
}

.danger-zone__title {
  color: #92736e;
  font-size: 23rpx;
  font-weight: 600;
}

.danger-zone__actions {
  display: flex;
  margin-top: 8rpx;
  gap: 12rpx;
}

.danger-zone__action {
  min-height: 88rpx;
  flex: 1;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #b84a3e;
  font-size: 24rpx;
  line-height: 88rpx;
}

.history-note {
  padding: 38rpx 28rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 20rpx;
  background: #ffffff;
  text-align: center;
}

.history-note__title,
.history-note__copy {
  display: block;
}

.history-note__title {
  color: #173b31;
  font-size: 30rpx;
  font-weight: 650;
}

.history-note__copy {
  margin: 10rpx 0 26rpx;
  color: #84918b;
  font-size: 23rpx;
}

@media (max-width: 340px) {
  .reminder-strip {
    align-items: stretch;
    flex-direction: column;
  }

  .reminder-strip__content {
    margin-right: 0;
  }

  .reminder-strip__button {
    width: 100%;
    margin-top: 18rpx;
  }
}

.detail {
  padding-top: 26rpx;
  padding-bottom: calc(196rpx + env(safe-area-inset-bottom));
}

.detail-loading {
  padding: 80rpx 0;
  color: #84918b;
  font-size: 26rpx;
  text-align: center;
}

.detail-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
  color: #9e3e34;
  font-size: 24rpx;
}

.detail-error button {
  min-width: 88rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

/* 顶部信息卡 */
.hero {
  box-sizing: border-box;
  padding: 30rpx 28rpx 26rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(23, 59, 49, 0.06);
}

.hero--danger { border-color: #eecdc8; }
.hero--urgent,
.hero--warning { border-color: #ecdcbe; }

/* 顶部信息卡：封面 + 分类/名称/状态 两栏 */
.hero__head {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.hero__cover {
  position: relative;
  box-sizing: border-box;
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 176rpx;
  overflow: hidden;
  border: 2rpx solid #e8efeb;
  border-radius: 22rpx;
  background: #f4f8f5;
}

/* 封面区分三层，从下往上：兜底占位图 / 转圈过渡 / 真图。
   2026-09-14 修闪动：原来真图静默态是 opacity:1，解码完成后再播一段
   `from opacity:0` 的入场动画 —— 图片先以不透明状态渲染出来，紧接着被动画
   拉回全透明再淡入，用户看到的就是"闪一下"。现在改成静态 opacity:0 +
   transition 到 1，透明不再需要动画去施加，闪动从根上消失。
   兜底占位图常驻，所以哪怕某机型不触发 bindload，封面区也不会空白。 */
.hero__cover-fallback {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.hero__cover-spinner {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
  margin: -22rpx 0 0 -22rpx;
  opacity: 0;
  transition: opacity 180ms ease-out;
}

.hero__cover-spinner--on { opacity: 1; }

.hero__cover-spinner-ring {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  border: 4rpx solid rgba(36, 91, 73, 0.16);
  border-top-color: #245b49;
  border-radius: 50%;
  animation: cover-spin 720ms linear infinite;
}

@keyframes cover-spin {
  to { transform: rotate(360deg); }
}

.hero__cover-img {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 2;
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 220ms ease-out;
}

.hero__cover-img--ready { opacity: 1; }

.hero__head-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.hero__kind {
  max-width: 100%;
  overflow: hidden;
  color: #6b7a73;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero__pill {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #e8f2ed;
  color: #1f5d49;
  font-size: 21rpx;
  font-weight: 650;
}

.hero--danger .hero__pill { background: #f8e9e6; color: #b84a3e; }
.hero--urgent .hero__pill,
.hero--warning .hero__pill { background: #f7ecdf; color: #9d6225; }

.hero__name {
  display: block;
  max-width: 100%;
  color: #173b31;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.25;
  word-break: break-word;
}

.hero__stats {
  display: flex;
  align-items: stretch;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #eef2f0;
}

.hero__stat {
  flex: 1;
  min-width: 0;
}

.hero__stat + .hero__stat {
  padding-left: 20rpx;
  border-left: 2rpx solid #eef2f0;
}

.hero__stat-label {
  display: block;
  color: #84918b;
  font-size: 21rpx;
}

.hero__stat-value {
  display: block;
  margin-top: 6rpx;
  color: #173b31;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

/* 信息列表 */
.card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx 10rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(23, 59, 49, 0.045);
}

.card__title {
  display: block;
  margin-bottom: 8rpx;
  color: #173b31;
  font-size: 28rpx;
  font-weight: 700;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f1f5f3;
}

.info-row:last-child { border-bottom: 0; }

.info-row__label {
  color: #6b7a73;
  font-size: 25rpx;
}

.info-row__value {
  max-width: 60%;
  color: #173b31;
  font-size: 26rpx;
  font-weight: 600;
  text-align: right;
}

.info-row__tail {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 62%;
}

.info-row__note {
  margin-top: 4rpx;
  color: #84918b;
  font-size: 21rpx;
}

.note {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border: 2rpx dashed #d5dfda;
  border-radius: 20rpx;
  background: #ffffff;
}

.note__title {
  display: block;
  color: #173b31;
  font-size: 28rpx;
  font-weight: 700;
}

.note__copy {
  display: block;
  margin-top: 8rpx;
  color: #6b7a73;
  font-size: 24rpx;
}

/* 底部操作条 */
.action-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 900;
  display: flex;
  align-items: center;
  padding: 10rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(23, 59, 49, 0.14);
}

.action-bar__button {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 0;
  padding: 0 6rpx;
  border-radius: 16rpx;
  background: transparent;
}

.action-bar__button + .action-bar__button {
  border-left: 2rpx solid #eef2f0;
}

.action-bar__button--pressed { background: #f1f6f3; }

.action-bar__text {
  color: #1f5d49;
  font-size: 27rpx;
  font-weight: 650;
}

.action-bar__text--danger { color: #b84a3e; }

@media (max-width: 340px) {
  .hero__cover { flex-basis: 148rpx; width: 148rpx; height: 148rpx; }
  .hero__name { font-size: 34rpx; }
  .hero__stat-value { font-size: 26rpx; }
  .action-bar__text { font-size: 24rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .hero__cover-img { transition: none; }
  .hero__cover-spinner { transition: none; }
  /* 不转圈，但保留高亮缺口的那一环，仍然能看出"在加载" */
  .hero__cover-spinner-ring { animation: none; }
}

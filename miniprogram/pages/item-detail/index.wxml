<view class="detail page-shell">
  <view wx:if="{{loading}}" class="detail-loading">正在读取物品信息…</view>

  <empty-state
    wx:elif="{{errorMessage && !item}}"
    title="无法显示物品"
    description="{{errorMessage}}"
    action-text="重新加载"
    bind:action="retry"
  />

  <block wx:elif="{{item}}">
    <view wx:if="{{errorMessage}}" class="detail-error" role="alert">
      <text>当前显示的是上次内容：{{errorMessage}}</text>
      <button bindtap="retry" hover-class="pressable--pressed">重试</button>
    </view>

    <view class="hero hero--{{item.expiryTone}}">
      <view class="hero__topline">
        <text class="hero__kind">{{item.categoryLabel}} · {{item.storageLabel}}</text>
        <text class="hero__pill">{{item.expiryStatusText}}</text>
      </view>
      <text class="hero__name">{{item.name}}</text>
      <view class="hero__stats">
        <view class="hero__stat">
          <text class="hero__stat-label">到期日期</text>
          <text class="hero__stat-value">{{item.expiryDate}}</text>
        </view>
        <view class="hero__stat">
          <text class="hero__stat-label">剩余</text>
          <text class="hero__stat-value">{{item.remainingDaysText || item.expiryStatusText}}</text>
        </view>
        <view class="hero__stat">
          <text class="hero__stat-label">数量</text>
          <text class="hero__stat-value">{{item.quantity}}{{item.unit}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="card__title">物品信息</text>
      <view class="info-list">
        <view class="info-row">
          <text class="info-row__label">分类</text>
          <text class="info-row__value">{{item.categoryLabel}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">存放位置</text>
          <text class="info-row__value">{{item.storageLabel}}</text>
        </view>
        <block wx:if="{{item.expiryInputMode === 'shelf_life'}}">
          <view class="info-row">
            <text class="info-row__label">生产日期</text>
            <text class="info-row__value">{{item.productionDate}}</text>
          </view>
          <view class="info-row">
            <text class="info-row__label">保质期</text>
            <text class="info-row__value">{{item.shelfLifeText}}</text>
          </view>
        </block>
        <view class="info-row">
          <text class="info-row__label">库存状态</text>
          <text class="info-row__value">{{item.inventoryStatusLabel}}</text>
        </view>
        <view class="info-row">
          <text class="info-row__label">提醒时间</text>
          <view class="info-row__tail">
            <text class="info-row__value">{{item.reminderAtText || '—'}}</text>
            <text wx:if="{{item.reminderAtNote}}" class="info-row__note">{{item.reminderAtNote}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{item.inventoryStatus === 'used_up'}}" class="note">
      <text class="note__title">这件物品已用完</text>
      <text class="note__copy">该记录不再参与当前库存统计，重新编辑确认后会再次入库。</text>
    </view>

    <view wx:elif="{{item.inventoryStatus === 'deleted' || item.inventoryStatus === 'discarded'}}" class="note">
      <text class="note__title">回收站</text>
      <text class="note__copy">{{item.purgeDateText ? '可在 ' + item.purgeDateText + ' 前恢复' : '可在清理前重新编辑恢复'}}，重新编辑确认后这件物品会再次进入库存。</text>
    </view>

    <view class="action-bar">
      <block wx:if="{{item.inventoryStatus === 'active'}}">
        <button class="action-bar__button" disabled="{{actionLoading}}" bindtap="editItem" hover-class="action-bar__button--pressed">
          <text class="action-bar__text">编辑</text>
        </button>
        <button class="action-bar__button" disabled="{{actionLoading}}" bindtap="confirmComplete" hover-class="action-bar__button--pressed">
          <text class="action-bar__text">已用完</text>
        </button>
        <button class="action-bar__button" disabled="{{actionLoading}}" bindtap="confirmDelete" hover-class="action-bar__button--pressed">
          <text class="action-bar__text action-bar__text--danger">删除</text>
        </button>
      </block>
      <block wx:else>
        <button class="action-bar__button" disabled="{{actionLoading}}" bindtap="restoreItem" hover-class="action-bar__button--pressed">
          <text class="action-bar__text">重新编辑</text>
        </button>
        <button class="action-bar__button" disabled="{{actionLoading}}" bindtap="confirmPermanentDelete" hover-class="action-bar__button--pressed">
          <text class="action-bar__text action-bar__text--danger">彻底删除</text>
        </button>
      </block>
    </view>
  </block>
</view>

<view class="detail page-shell">
  <view wx:if="{{loading}}" class="detail-loading">正在读取物品信息…</view>

  <empty-state
    wx:elif="{{errorMessage && !item}}"
    title="无法显示物品"
    description="{{errorMessage}}"
    action-text="重新加载"
    bind:action="retry"
  />

  <block wx:elif="{{item}}">
    <view wx:if="{{errorMessage}}" class="detail-error" role="alert">
      <text>当前显示的是上次内容：{{errorMessage}}</text>
      <button bindtap="retry" hover-class="pressable--pressed">重试</button>
    </view>

    <view class="detail-hero detail-hero--{{item.expiryTone}}">
      <view class="detail-hero__topline">
        <text class="detail-hero__label">保鲜标签</text>
        <text class="detail-hero__kind">{{item.categoryLabel}} · {{item.storageLabel}}</text>
      </view>
      <text class="detail-hero__name">{{item.name}}</text>
      <text class="detail-hero__status detail-hero__status--{{item.expiryTone}}">{{item.expiryStatusText}}</text>
      <view class="detail-hero__expiry">
        <text class="detail-hero__expiry-label">到期日期</text>
        <text class="detail-hero__expiry-date">{{item.expiryDate}}</text>
      </view>
    </view>

    <view class="detail-section detail-section--plain">
      <view class="detail-section__heading">
        <text class="detail-section__title">物品信息</text>
        <button
          wx:if="{{item.inventoryStatus === 'active'}}"
          class="text-action"
          bindtap="editItem"
          hover-class="pressable--pressed"
          aria-label="编辑物品"
        >
          <view class="line-icon line-icon--edit text-action__icon" aria-hidden="true"></view>
          <text>编辑</text>
        </button>
      </view>
      <view class="detail-list">
        <view class="detail-list__row">
          <text class="detail-list__label">当前数量</text>
          <text class="detail-list__value detail-list__value--strong">{{item.quantity}}{{item.unit}}</text>
        </view>
        <view class="detail-list__row">
          <text class="detail-list__label">分类</text>
          <text class="detail-list__value">{{item.categoryLabel}}</text>
        </view>
        <view class="detail-list__row">
          <text class="detail-list__label">存放位置</text>
          <text class="detail-list__value">{{item.storageLabel}}</text>
        </view>
        <block wx:if="{{item.expiryInputMode === 'shelf_life'}}">
          <view class="detail-list__row">
            <text class="detail-list__label">生产日期</text>
            <text class="detail-list__value">{{item.productionDate}}</text>
          </view>
          <view class="detail-list__row">
            <text class="detail-list__label">保质期</text>
            <text class="detail-list__value">{{item.shelfLifeText}}</text>
          </view>
        </block>
        <view class="detail-list__row">
          <text class="detail-list__label">库存状态</text>
          <text class="detail-list__value">{{item.inventoryStatusLabel}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{item.inventoryStatus === 'active'}}" class="reminder-strip">
      <view class="reminder-strip__content">
        <view class="reminder-strip__heading">
          <text class="reminder-strip__title">微信临期提醒</text>
          <text class="reminder-strip__lead">提前 {{item.reminderLeadDays}} 天</text>
        </view>
        <text class="reminder-strip__copy">{{item.reminderCopy}}</text>
        <button
          wx:if="{{item.reminderStatus === 'scheduled'}}"
          class="cancel-reminder"
          bindtap="cancelReminder"
          hover-class="pressable--pressed"
        >取消本次提醒</button>
      </view>
      <button
        class="reminder-strip__button"
        disabled="{{actionLoading || item.reminderActionDisabled || item.expiryStatus === 'expired'}}"
        bindtap="requestReminder"
        hover-class="pressable--pressed"
      >{{item.expiryStatus === 'expired' ? '无需提醒' : item.reminderActionText}}</button>
    </view>

    <view wx:if="{{item.inventoryStatus === 'active'}}" class="stock-actions">
      <text class="detail-section__title">处理库存</text>
      <button
        class="primary-button stock-actions__primary"
        disabled="{{actionLoading}}"
        bindtap="confirmComplete"
        hover-class="pressable--pressed"
      >标记为已用完</button>
      <view class="decrement-control">
        <text class="decrement-control__label">数量减</text>
        <input
          class="decrement-control__input"
          value="{{decrementAmount}}"
          type="number"
          maxlength="4"
          bindinput="handleDecrementInput"
          aria-label="减少数量"
        />
        <button
          class="secondary-button decrement-control__button"
          disabled="{{actionLoading}}"
          bindtap="decrement"
          hover-class="pressable--pressed"
        >确认</button>
      </view>
    </view>

    <view wx:if="{{item.inventoryStatus === 'active'}}" class="danger-zone">
      <button class="danger-button delete-button" disabled="{{actionLoading}}" bindtap="confirmDelete" hover-class="pressable--pressed">删除</button>
    </view>

    <view wx:elif="{{item.inventoryStatus === 'used_up'}}" class="history-note">
      <text class="history-note__title">这件物品已用完</text>
      <text class="history-note__copy">该记录不再参与当前库存统计。</text>
      <button class="secondary-button" bindtap="backHome" hover-class="pressable--pressed">返回当前库存</button>
      <button class="danger-button history-note__delete" disabled="{{actionLoading}}" bindtap="confirmDelete" hover-class="pressable--pressed">删除</button>
    </view>

    <view wx:else class="trash-note">
      <text class="trash-note__eyebrow">回收站</text>
      <text class="trash-note__title">可在 {{item.purgeDateText || '近期' }} 前恢复</text>
      <text class="trash-note__copy">重新编辑并确认后，这件物品会再次进入库存。</text>
      <button class="primary-button" disabled="{{actionLoading}}" bindtap="restoreItem" hover-class="pressable--pressed">重新编辑</button>
      <button class="danger-button trash-note__delete" disabled="{{actionLoading}}" bindtap="confirmPermanentDelete" hover-class="pressable--pressed">彻底删除</button>
    </view>
  </block>
</view>

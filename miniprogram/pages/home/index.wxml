<view class="home page-shell">
  <view wx:if="{{errorMessage}}" class="error-banner">
    <text class="error-banner__text">{{errorMessage}}</text>
    <button class="error-banner__action" bindtap="retry" hover-class="pressable--pressed">重试</button>
  </view>

  <view wx:if="{{!overview}}" class="stat-row">
    <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="stat-card stat-card--skeleton"></view>
  </view>
  <view wx:else class="stat-row" aria-label="库存概览">
    <view
      class="stat-card stat-card--total {{viewStatus === 'active_all' ? 'stat-card--selected' : ''}}"
      data-card="activeTotal"
      bindtap="selectOverviewCard"
      hover-class="stat-card--pressed"
      role="button"
      aria-label="在库 {{overview.activeTotal}} 件，查看全部在库物品"
    >
      <text class="stat-card__label">在库</text>
      <text class="stat-card__number">{{overview.activeTotal}}</text>
    </view>
    <view
      class="stat-card stat-card--expiring {{viewStatus === 'expiring' ? 'stat-card--selected' : ''}}"
      data-card="expiringWithin7Days"
      bindtap="selectOverviewCard"
      hover-class="stat-card--pressed"
      role="button"
      aria-label="临期 {{overview.expiringWithin7Days}} 件，查看临期物品"
    >
      <text class="stat-card__label">临期</text>
      <text class="stat-card__number">{{overview.expiringWithin7Days}}</text>
    </view>
    <view
      class="stat-card stat-card--expired {{viewStatus === 'expired' ? 'stat-card--selected' : ''}}"
      data-card="expired"
      bindtap="selectOverviewCard"
      hover-class="stat-card--pressed"
      role="button"
      aria-label="已过期 {{overview.expired}} 件，查看已过期物品"
    >
      <text class="stat-card__label">已过期</text>
      <text class="stat-card__number">{{overview.expired}}</text>
    </view>
    <view
      class="stat-card stat-card--used {{viewStatus === 'used_up' ? 'stat-card--selected' : ''}}"
      data-card="usedUpTotal"
      bindtap="selectOverviewCard"
      hover-class="stat-card--pressed"
      role="button"
      aria-label="已用完 {{overview.usedUpTotal}} 件，查看已用完物品"
    >
      <text class="stat-card__label">已用完</text>
      <text class="stat-card__number">{{overview.usedUpTotal}}</text>
    </view>
  </view>

  <view class="library">
    <view class="query-panel">
      <view class="query-top">
      <view class="search-box">
        <view class="line-icon line-icon--search search-box__icon" aria-hidden="true"></view>
        <input
          class="search-box__input"
          value="{{search}}"
          placeholder="搜索名称或存放位置"
          placeholder-class="search-box__placeholder"
          confirm-type="search"
          bindinput="handleSearchInput"
        />
        <button wx:if="{{search}}" class="search-box__clear" bindtap="clearSearch" hover-class="pressable--pressed" aria-label="清空搜索">清空</button>
      </view>
      <button wx:if="{{hasActiveConditions}}" class="filter-actions__clear" bindtap="resetFilters" hover-class="pressable--pressed">清除全部</button>
      <button class="library__batch" disabled="{{loading || !items.length}}" bindtap="openBatchOperations" hover-class="pressable--pressed">批量操作</button>
      </view>

      <view class="filter-section">
        <text class="filter-section__label">种类</text>
        <view class="filter-grid" role="radiogroup" aria-label="按种类筛选">
          <button
            wx:for="{{categoryOptions}}"
            wx:key="value"
            wx:for-item="option"
            class="filter-option {{category === option.value ? 'filter-option--active' : ''}}"
            data-value="{{option.value}}"
            bindtap="selectCategory"
            hover-class="filter-option--pressed"
            role="radio"
            aria-selected="{{category === option.value}}"
          >{{option.label}}</button>
        </view>
      </view>

      <view class="filter-section">
        <text class="filter-section__label">状态</text>
        <view class="filter-grid" role="radiogroup" aria-label="按状态筛选">
          <button
            wx:for="{{statusOptions}}"
            wx:key="value"
            wx:for-item="option"
            class="filter-option {{viewStatus === option.value ? 'filter-option--active' : ''}}"
            data-value="{{option.value}}"
            bindtap="selectStatus"
            hover-class="filter-option--pressed"
            role="radio"
            aria-selected="{{viewStatus === option.value}}"
          >{{option.label}}</button>
        </view>
      </view>

      <view class="filter-section">
        <text class="filter-section__label">排序</text>
        <view class="filter-grid filter-grid--quad" role="radiogroup" aria-label="按排序方式筛选">
          <button
            wx:for="{{sortOptions}}"
            wx:key="value"
            wx:for-item="option"
            class="filter-option {{sort === option.value ? 'filter-option--active' : ''}}"
            data-value="{{option.value}}"
            bindtap="selectSort"
            hover-class="filter-option--pressed"
            role="radio"
            aria-selected="{{sort === option.value}}"
          >{{option.label}}</button>
        </view>
      </view>

    </view>

    <view wx:if="{{listErrorMessage}}" class="error-banner error-banner--list">
      <text class="error-banner__text">{{listErrorMessage}}</text>
      <button class="error-banner__action" bindtap="retry" hover-class="pressable--pressed">重试</button>
    </view>

    <view wx:if="{{loading}}" class="loading-list" aria-label="正在加载物品">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="loading-row">
        <view class="loading-row__line"></view>
        <view class="loading-row__line loading-row__line--short"></view>
      </view>
    </view>

    <block wx:elif="{{items.length}}">
      <view class="item-list">
        <inventory-row
          wx:for="{{items}}"
          wx:for-item="inventoryItem"
          wx:key="_id"
          item="{{inventoryItem}}"
          bind:select="openItem"
          bind:edit="editItem"
          bind:quantity="openQuantity"
          bind:more="openMore"
        />
      </view>

      <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view>
      <view wx:elif="{{loadMoreError}}" class="load-more load-more--error">
        <text>{{loadMoreError}}</text>
        <button class="load-more__retry" bindtap="retryLoadMore" hover-class="pressable--pressed">重试</button>
      </view>
      <view wx:elif="{{!nextCursor}}" class="load-more">已经到底了</view>
    </block>

    <empty-state
      wx:elif="{{!listErrorMessage}}"
      title="{{hasActiveConditions ? '没有匹配的物品' : '先记下第一件物品'}}"
      description="{{hasActiveConditions ? '保留了当前条件，可以清除后再试' : '只需名称和到期日期，之后随时可以补充'}}"
      action-text="{{hasActiveConditions ? '清除筛选' : '新增物品'}}"
      bind:action="handleEmptyAction"
    />
  </view>

  <view wx:if="{{quantitySheet.visible}}" class="sheet-mask" bindtap="closeQuantity" catchtouchmove="noop">
    <view class="dialog" catchtap="noop" role="dialog" aria-modal="true" aria-label="调整数量">
      <text class="dialog__title">调整数量</text>
      <text class="dialog__subtitle">{{quantitySheet.name}}</text>
      <view class="stepper">
        <button
          class="stepper__button"
          data-delta="-1"
          bindtap="stepQuantity"
          hover-class="stepper__button--pressed"
          aria-label="减少 1"
        >−</button>
        <input
          class="stepper__input"
          type="number"
          value="{{quantitySheet.value}}"
          maxlength="4"
          bindinput="handleQuantityInput"
          aria-label="物品数量"
        />
        <button
          class="stepper__button"
          data-delta="1"
          bindtap="stepQuantity"
          hover-class="stepper__button--pressed"
          aria-label="增加 1"
        >＋</button>
      </view>
      <text class="dialog__hint">可输入 1～9999 的正整数</text>
      <view class="dialog__actions">
        <button class="secondary-button dialog__button" bindtap="closeQuantity" hover-class="pressable--pressed">取消</button>
        <button
          class="primary-button dialog__button"
          disabled="{{actionLoading}}"
          bindtap="submitQuantity"
          hover-class="pressable--pressed"
        >保存</button>
      </view>
    </view>
  </view>

  <view wx:if="{{moreSheet.visible}}" class="sheet-mask" bindtap="closeMore" catchtouchmove="noop">
    <view class="action-sheet" catchtap="noop" role="dialog" aria-modal="true" aria-label="更多操作">
      <view class="action-sheet__head">
        <text class="action-sheet__title">{{moreSheet.name}}</text>
      </view>
      <button class="action-sheet__item" data-action="complete" bindtap="handleMoreAction" hover-class="action-sheet__item--pressed">
        <view class="action-sheet__icon action-sheet__icon--check" aria-hidden="true"></view>
        <text class="action-sheet__label">标记为已用完</text>
      </button>
      <button class="action-sheet__item" data-action="delete" bindtap="handleMoreAction" hover-class="action-sheet__item--pressed">
        <view class="action-sheet__icon action-sheet__icon--trash" aria-hidden="true"></view>
        <text class="action-sheet__label action-sheet__label--danger">删除</text>
      </button>
      <button class="action-sheet__item" data-action="remind" bindtap="handleMoreAction" hover-class="action-sheet__item--pressed">
        <view class="action-sheet__icon action-sheet__icon--bell" aria-hidden="true"></view>
        <text class="action-sheet__label">提醒</text>
      </button>
      <button class="action-sheet__cancel" bindtap="closeMore" hover-class="action-sheet__item--pressed">取消</button>
    </view>
  </view>
</view>

<view class="home page-shell">
  <view class="page-heading">
    <text class="page-heading__title">库存概览</text>
  </view>

  <view wx:if="{{errorMessage}}" class="error-banner">
    <text class="error-banner__text">{{errorMessage}}</text>
    <button class="error-banner__action" bindtap="retry" hover-class="pressable--pressed">重试</button>
  </view>

  <view wx:if="{{loading}}" class="overview-skeleton" aria-label="正在加载库存概览">
    <view class="overview-skeleton__grid">
      <view wx:for="{{[1, 2, 3, 4]}}" wx:key="*this" class="overview-skeleton__card"></view>
    </view>
  </view>

  <block wx:elif="{{overview}}">
    <view class="status-grid" aria-label="库存状态">
      <view class="status-card status-card--total" data-card="activeTotal" bindtap="openInventory" hover-class="overview-card--pressed" role="button" aria-label="物品总数 {{overview.activeTotal}}，查看全部在库物品">
        <view class="status-card__topline">
          <view class="overview-icon overview-icon--inventory" aria-hidden="true"><view class="overview-icon__glyph"></view></view>
          <text class="status-card__number">{{overview.activeTotal}}</text>
        </view>
        <text class="status-card__label">物品总数</text>
      </view>
      <view class="status-card status-card--danger" data-card="expired" bindtap="openInventory" hover-class="overview-card--pressed" role="button" aria-label="已过期 {{overview.expired}}，查看已过期物品">
        <view class="status-card__topline">
          <view class="overview-icon overview-icon--expired" aria-hidden="true"><view class="overview-icon__glyph"></view></view>
          <text class="status-card__number">{{overview.expired}}</text>
        </view>
        <text class="status-card__label">已过期</text>
      </view>
      <view class="status-card status-card--warning" data-card="expiringWithin7Days" bindtap="openInventory" hover-class="overview-card--pressed" role="button" aria-label="临期 {{overview.expiringWithin7Days}}，查看七天内到期物品">
        <view class="status-card__topline">
          <view class="overview-icon overview-icon--expiring" aria-hidden="true"><view class="overview-icon__glyph"></view></view>
          <text class="status-card__number">{{overview.expiringWithin7Days}}</text>
        </view>
        <text class="status-card__label">临期</text>
      </view>
      <view class="status-card status-card--neutral" data-card="usedUpTotal" bindtap="openInventory" hover-class="overview-card--pressed" role="button" aria-label="已用完 {{overview.usedUpTotal}}，查看已用完物品">
        <view class="status-card__topline">
          <view class="overview-icon overview-icon--used" aria-hidden="true"><view class="overview-icon__glyph"></view></view>
          <text class="status-card__number">{{overview.usedUpTotal}}</text>
        </view>
        <text class="status-card__label">已用完</text>
      </view>
    </view>

    <view class="expiring-section">
      <view class="expiring-section__heading">
        <text class="expiring-section__title">临期物品</text>
        <text class="expiring-section__count">{{overview.expiringWithin7Days}} 项</text>
      </view>
      <view wx:if="{{expiringItems.length}}" class="expiring-list">
        <inventory-row wx:for="{{expiringItems}}" wx:key="_id" item="{{item}}" bind:select="openItem" />
      </view>
      <view wx:else class="expiring-empty">
        <text>近期没有即将过期的物品</text>
      </view>
    </view>
  </block>

  <view class="home__bottom-space"></view>
  <button class="add-button" bindtap="addItem" hover-class="pressable--pressed" aria-label="新增物品">
    <text class="add-button__plus" aria-hidden="true">＋</text>
    <text>新增</text>
  </button>
</view>

page { background: #f3f8f6; }
.home { padding: 0 24rpx calc(180rpx + env(safe-area-inset-bottom)); background: radial-gradient(ellipse at 80% 0%, #e2f0e8 0%, transparent 36%), linear-gradient(180deg, #edf6f2, #f7faf9 540rpx, #f3f8f6); }
.hero { position: relative; box-sizing: content-box; height: 84rpx; margin: 0 -24rpx; padding-left: 36rpx; padding-right: 32rpx; overflow: hidden; }
.hero__title { position: relative; display: block; color: #104f41; font-size: 46rpx; font-weight: 800; line-height: 1.25; letter-spacing: 2rpx; }
.hero__leaf { position: absolute; width: 95rpx; height: 190rpx; border-radius: 100% 0 100% 0; background: linear-gradient(30deg, #b8ddc7, #d4e7d2); opacity: .48; transform: rotate(25deg); }
.hero__leaf--one { right: -8rpx; bottom: -6rpx; }
.hero__leaf--two { right: 195rpx; bottom: -100rpx; transform: rotate(-40deg); }
.stat-row { position: relative; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12rpx; margin: 0; padding: 14rpx 12rpx 16rpx; border-radius: 30rpx 30rpx 0 0; background: rgba(255,255,255,.94); }
.stat-card {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr);
  align-items: center;
  align-content: center;
  gap: 4rpx 12rpx;
  box-sizing: border-box;
  min-height: 92rpx;
  padding: 12rpx;
  border: 2rpx solid transparent;
  border-radius: 17rpx;
  background: #effaf5;
}
.stat-card--total { background: linear-gradient(125deg,#eaf9f1,#f1fbf6); color: #145745; }
.stat-card--expiring { background: linear-gradient(125deg,#fdf7ed,#fffaf2); color: #e08a0a; }
.stat-card--expired { background: linear-gradient(125deg,#fdf0f3,#fff6f6); color: #df4d58; }
.stat-card--used { background: linear-gradient(125deg,#edf7ff,#f2faff); color: #4b84a0; }
.stat-card--selected { border-color: rgba(46,128,98,.22); }
.stat-card--pressed { opacity: .7; }
.stat-card__number { grid-column: 2; grid-row: 1; min-width: 0; color: inherit; font-size: 32rpx; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; overflow-wrap: anywhere; }
.stat-card__label { grid-column: 2; grid-row: 2; color: inherit; opacity: .8; font-size: 20rpx; line-height: 1.3; white-space: nowrap; }
.stat-card__icon { grid-column: 1; grid-row: 1 / span 2; position: relative; width: 44rpx; height: 44rpx; border-radius: 50%; background: linear-gradient(135deg,#4cad74,#85d39b); box-shadow: inset 0 0 0 2rpx rgba(255,255,255,.5), 0 4rpx 8rpx rgba(50,100,80,.06); }
.stat-card__icon--clock { background: linear-gradient(135deg,#ffb71b,#ed8b00); }
.stat-card__icon--clock::after { position: absolute; left: 21rpx; top: 10rpx; height: 16rpx; width: 10rpx; border-left: 3rpx solid white; border-bottom: 3rpx solid white; content: ''; transform: rotate(-15deg); }
.stat-card__icon--alert { background: linear-gradient(135deg,#f13346,#ff8c94); color: white; text-align: center; font-size: 36rpx; line-height: 44rpx; font-weight: 700; }
.stat-card__icon--check { background: linear-gradient(135deg,#3f94ee,#98c7ff); }
.stat-card__icon--check::after { position: absolute; left: 12rpx; top: 11rpx; width: 18rpx; height: 10rpx; border-left: 5rpx solid white; border-bottom: 5rpx solid white; transform: rotate(-45deg); content: ''; }
.stat-card__icon--box { border-radius: 13rpx; }
.stat-card__icon--box view { position: absolute; left: 12rpx; top: 11rpx; width: 19rpx; height: 19rpx; border: 3rpx solid #fff; transform: rotate(30deg) skewY(-10deg); }
.stat-card--skeleton { background: #e7efeb; animation: stat-pulse 1.2s ease-in-out infinite alternate; }
@keyframes stat-pulse { from { opacity: .5; } to { opacity: 1; } }
.library { margin: 0; }
.query-panel { padding: 2rpx 12rpx 22rpx; background: linear-gradient(180deg,rgba(255,255,255,.94),rgba(255,255,255,.35)); border-radius: 0 0 26rpx 26rpx; }
.query-top { display: flex; align-items: center; gap: 10rpx; margin-bottom: 20rpx; }
.search-box { display: flex; align-items: center; flex: 1; min-width: 0; box-sizing: border-box; height: 72rpx; padding: 0 16rpx; border: 1rpx solid #e2e8e9; border-radius: 40rpx; background: #f3f6f7; }
.search-box__icon { margin-right: 10rpx; color: #71808b; }
.search-box__input { flex: 1; min-width: 0; height: 70rpx; color: #263d46; font-size: 22rpx; }
.search-box__placeholder { color: #97a2aa; }
.search-box__clear { margin: 0; padding: 0 4rpx; font-size: 20rpx; background: transparent; color: #6c8a7b; }
.query-action {
  display: flex;
  flex: 0 0 108rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 64rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 20rpx;
  font-size: 21rpx;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
}
.query-action--reset { border: 1rpx solid #e1e8e5; background: #f5f8f6; color: #6c8179; }
.query-action--batch { background: #e5f3ec; color: #28755e; }
.query-action[disabled] { border-color: transparent; background: #f2f5f3; color: #a6b2ac; }
.filter-section { display: flex; align-items: center; margin-top: 16rpx; }
.filter-section__label { flex: 0 0 56rpx; margin-right: 12rpx; color: #30434e; font-size: 23rpx; }
.filter-grid { flex: 1; display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 9rpx; }
.filter-grid--quad { grid-template-columns: repeat(4,minmax(0,1fr)); }
.filter-option { box-sizing: border-box; min-width: 0; height: 50rpx; margin: 0; padding: 0 2rpx; border: 0; border-radius: 21rpx; background: #f0f4f5; color: #46545f; font-size: 21rpx; line-height: 50rpx; white-space: nowrap; }
.filter-option--active { background: linear-gradient(115deg,#338b70,#28755e); color: white; box-shadow: inset 0 1rpx 2rpx rgba(255,255,255,.25); }
.filter-option--pressed { opacity: .7; }
.item-list { margin-top: 2rpx; }
.loading-list { padding-top: 16rpx; }
.loading-row { height: 146rpx; box-sizing: border-box; margin-bottom: 16rpx; padding: 27rpx 28rpx; border: 1rpx solid rgba(49,112,87,.05); border-radius: 24rpx; background: white; }
.loading-row__line { width: 55%; height: 26rpx; border-radius: 10rpx; background: #e8efeb; }
.loading-row__line--short { width: 34%; height: 18rpx; margin-top: 20rpx; }
.load-more { padding: 26rpx 0; color: #93a49f; font-size: 21rpx; text-align: center; }
.load-more--error { color: #b84a3e; }
.load-more__retry { display: inline-block; margin: 0; padding: 0 16rpx; background: transparent; color: #b84a3e; font-size: 22rpx; }
.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
}

.error-banner--list { margin-bottom: 8rpx; }
.error-banner__text { max-width: 480rpx; color: #9e3e34; font-size: 24rpx; }

.error-banner__action {
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
}

/* 弹窗 */
.sheet-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 4000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 0 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: rgba(18, 38, 32, 0.38);
}

.action-sheet {
  box-sizing: border-box;
  width: 100%;
  padding: 12rpx 0 0;
  overflow: hidden;
  border-radius: 26rpx;
  background: #ffffff;
}

.action-sheet__head {
  padding: 22rpx 30rpx 20rpx;
  border-bottom: 2rpx solid #eef2f0;
}

.action-sheet__title {
  color: #53645d;
  font-size: 24rpx;
}

.action-sheet__item {
  display: flex;
  align-items: center;
  width: 100%;
  height: 108rpx;
  margin: 0;
  padding: 0 30rpx;
  background: #ffffff;
  text-align: left;
}

.action-sheet__item--pressed { background: #f3f7f5; }

.action-sheet__icon {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
}

.action-sheet__label { color: #173b31; font-size: 29rpx; font-weight: 600; text-align: left; }
.action-sheet__label--danger { color: #b84a3e; }

.action-sheet__cancel {
  width: 100%;
  height: 104rpx;
  margin: 12rpx 0 0;
  padding: 0;
  border-top: 2rpx solid #eef2f0;
  background: #ffffff;
  color: #6b7a73;
  font-size: 29rpx;
  line-height: 104rpx;
}

@media (max-width: 340px) {
  .query-panel { padding-right: 16rpx; padding-left: 16rpx; }
  .filter-grid { gap: 6rpx; }
  .filter-option { font-size: 20rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .stat-card { transition: none; }
  .stat-card--skeleton { animation: none; }
}

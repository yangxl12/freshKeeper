.home { padding-top: 30rpx; }

.page-heading__title {
  display: block;
  color: #173b31;
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
}

.error-banner__text { max-width: 500rpx; color: #9e3e34; font-size: 24rpx; }

.error-banner__action {
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.status-grid,
.overview-skeleton__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 34rpx;
}

.status-card,
.overview-skeleton__card {
  box-sizing: border-box;
  min-height: 204rpx;
  border-radius: 14rpx;
}

.status-card {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx 22rpx;
  border: 2rpx solid #d9e2dd;
  border-top: 7rpx solid #1f5d49;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(23, 59, 49, 0.055);
  transition: opacity 120ms ease, transform 120ms ease;
}

.status-card--danger { border-top-color: #b84a3e; }
.status-card--warning { border-top-color: #c77b30; }
.status-card--neutral { border-top-color: #7f8c86; }

.status-card__number {
  color: #173b31;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  margin-top: 10rpx;
  font-size: 62rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  line-height: 1;
}

.status-card__label {
  color: #65766e;
  font-size: 23rpx;
  font-weight: 650;
}

.status-card__meta {
  margin-top: auto;
  padding-top: 9rpx;
  border-top: 2rpx solid #edf1ee;
  color: #93a099;
  font-size: 20rpx;
}

.status-card--danger .status-card__number { color: #b84a3e; }
.status-card--warning .status-card__number { color: #a96524; }
.status-card--neutral .status-card__number { color: #61716a; }

.overview-card--pressed { opacity: 0.72; transform: scale(0.985); }

.expiring-section { margin-top: 48rpx; }

.expiring-section__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 4rpx;
}

.expiring-section__title {
  color: #173b31;
  font-size: 31rpx;
  font-weight: 650;
}

.expiring-section__count {
  color: #84918b;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 22rpx;
}

.expiring-section__actions {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-batch-button {
  min-height: 62rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid #cbd8d2;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1f5d49;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 60rpx;
}

.section-batch-button[disabled] { opacity: 0.42; }

.expiring-list { margin-top: 20rpx; }

.expiring-empty {
  margin-top: 20rpx;
  padding: 42rpx 24rpx;
  border: 2rpx dashed #d5dfda;
  border-radius: 20rpx;
  color: #84918b;
  font-size: 24rpx;
  text-align: center;
}

.overview-skeleton__card {
  background: #e1e8e4;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.home__bottom-space { height: 132rpx; }

.add-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  min-width: 88rpx;
  padding: 0;
  border-radius: 50%;
  background: #1f5d49;
  box-shadow: 0 14rpx 30rpx rgba(23, 59, 49, 0.22);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.add-button__plus { font-size: 42rpx; font-weight: 300; }

@keyframes skeleton-pulse {
  from { opacity: 0.62; }
  to { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .overview-skeleton__card { animation: none; }
}

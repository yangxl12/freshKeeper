.home { padding-top: 30rpx; }

.page-heading__eyebrow,
.page-heading__title,
.page-heading__hint { display: block; }

.page-heading__eyebrow {
  color: #84918b;
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.18em;
}

.page-heading__title {
  margin-top: 5rpx;
  color: #173b31;
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-heading__hint { margin-top: 8rpx; color: #718079; font-size: 23rpx; }

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
}

.error-banner__text { max-width: 500rpx; color: #9e3e34; font-size: 24rpx; }

.error-banner__action {
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.total-card,
.overview-skeleton__main {
  box-sizing: border-box;
  min-height: 270rpx;
  margin-top: 34rpx;
  border-radius: 28rpx;
}

.total-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  background: #1f5d49;
  box-shadow: 0 16rpx 38rpx rgba(23, 59, 49, 0.16);
  color: #ffffff;
  transition: opacity 120ms ease, transform 120ms ease;
}

.total-card::after {
  position: absolute;
  right: -54rpx;
  bottom: -82rpx;
  width: 230rpx;
  height: 230rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.09);
  border-radius: 50%;
  content: "";
}

.total-card__tag-hole {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  box-sizing: border-box;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 50%;
  background: #174b3c;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.12);
}

.total-card__topline,
.total-card__content,
.status-card__footer { display: flex; align-items: center; justify-content: space-between; }

.total-card__topline,
.total-card__content { position: relative; z-index: 1; }
.total-card__topline { padding-right: 40rpx; }
.total-card__label { color: rgba(255, 255, 255, 0.84); font-size: 26rpx; font-weight: 600; letter-spacing: 0.08em; }
.total-card__date { color: rgba(255, 255, 255, 0.58); font-family: "DIN Alternate", "Arial Narrow", sans-serif; font-size: 21rpx; }

.total-card__content {
  align-items: flex-end;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 2rpx dashed rgba(255, 255, 255, 0.2);
}

.total-card__number,
.status-card__number {
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

.total-card__number { font-size: 92rpx; line-height: 0.95; }
.total-card__number--compact { font-size: 72rpx; }
.total-card__aside { display: flex; align-items: flex-end; flex-direction: column; padding-bottom: 2rpx; }
.total-card__caption { color: rgba(255, 255, 255, 0.62); font-size: 22rpx; }
.total-card__link { margin-top: 7rpx; color: #ffffff; font-size: 24rpx; font-weight: 600; }

.status-grid,
.overview-skeleton__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 18rpx;
}

.status-card,
.overview-skeleton__card { box-sizing: border-box; min-height: 196rpx; border-radius: 20rpx; }

.status-card {
  display: flex;
  justify-content: space-between;
  flex-direction: column;
  padding: 24rpx;
  border: 2rpx solid #dde5e0;
  background: #ffffff;
  transition: opacity 120ms ease, transform 120ms ease;
}

.status-card--danger .status-card__number { color: #b84a3e; }
.status-card--warning .status-card__number { color: #a96524; }
.status-card--safe .status-card__number { color: #1f5d49; }
.status-card--neutral .status-card__number { color: #68766f; }
.status-card__number { color: #173b31; font-size: 60rpx; line-height: 1; }
.status-card__label { color: #53645d; font-size: 26rpx; font-weight: 600; }
.status-card__arrow { color: #9aa69f; font-size: 28rpx; }
.overview-card--pressed { opacity: 0.75; transform: scale(0.985); }

.empty-hint {
  margin-top: 36rpx;
  padding: 26rpx 28rpx;
  border-left: 6rpx solid #1f5d49;
  background: #e8f2ed;
}

.empty-hint__title,
.empty-hint__copy { display: block; }
.empty-hint__title { color: #173b31; font-size: 27rpx; font-weight: 600; }
.empty-hint__copy { margin-top: 4rpx; color: #68766f; font-size: 23rpx; }

.overview-skeleton__main,
.overview-skeleton__card {
  background: #e1e8e4;
  animation: skeleton-pulse 1.2s ease-in-out infinite alternate;
}

.home__bottom-space { height: 132rpx; }

.add-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 44rpx;
  background: #1f5d49;
  box-shadow: 0 14rpx 30rpx rgba(23, 59, 49, 0.22);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.add-button__plus { margin-right: 6rpx; font-size: 34rpx; font-weight: 400; }

@keyframes skeleton-pulse {
  from { opacity: 0.62; }
  to { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .overview-skeleton__main,
  .overview-skeleton__card { animation: none; }
}

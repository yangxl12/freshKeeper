.home {
  padding-top: 24rpx;
}

.hero {
  padding: 20rpx 4rpx 28rpx;
}

.hero__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.hero__eyebrow,
.hero__title {
  display: block;
}

.hero__eyebrow {
  color: #668075;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.hero__title {
  margin-top: 8rpx;
  color: #18342d;
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.24;
}

.hero__date {
  padding-bottom: 5rpx;
  color: #7a8882;
  font-family: "DIN Alternate", monospace;
  font-size: 22rpx;
}

.overview {
  display: flex;
  align-items: stretch;
  margin-top: 34rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid #d8e1dc;
  border-bottom: 2rpx solid #d8e1dc;
}

.overview__item {
  display: flex;
  align-items: center;
  flex: 1;
  flex-direction: column;
}

.overview__value {
  color: #204438;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1;
}

.overview__label {
  margin-top: 10rpx;
  color: #75837d;
  font-size: 22rpx;
}

.overview__item--danger .overview__value {
  color: #a33f32;
}

.overview__item--warning .overview__value {
  color: #9b6421;
}

.overview__divider {
  width: 2rpx;
  background: #dce4e0;
}

.query-panel {
  margin: 10rpx 0 36rpx;
}

.search-box {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 20rpx;
  border: 2rpx solid #d7e0dc;
  border-radius: 18rpx;
  background: #fbfcfa;
}

.search-box__icon {
  margin-right: 14rpx;
  color: #6f8279;
  font-size: 35rpx;
  line-height: 1;
}

.search-box__input {
  height: 84rpx;
  flex: 1;
  color: #18342d;
  font-size: 28rpx;
}

.search-box__placeholder {
  color: #96a39d;
}

.search-box__clear {
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  background: transparent;
  color: #84928c;
  font-size: 36rpx;
  line-height: 88rpx;
}

.filters {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 14rpx;
}

.filter {
  flex: 1;
}

.filter__control {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 2rpx solid #dde5e1;
  border-radius: 14rpx;
  background: #f9fbf8;
  color: #506159;
  font-size: 25rpx;
}

.filter__arrow {
  margin-left: 10rpx;
  color: #829089;
}

.filters__reset {
  min-width: 94rpx;
  height: 88rpx;
  padding: 0 12rpx;
  background: transparent;
  color: #2f6b57;
  font-size: 25rpx;
  line-height: 88rpx;
}

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 26rpx;
  padding: 20rpx 22rpx;
  border-left: 6rpx solid #b44535;
  background: #fff4f1;
}

.error-banner__text {
  max-width: 500rpx;
  color: #8f392e;
  font-size: 25rpx;
}

.error-banner__action {
  min-width: 96rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #8f392e;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.inventory-group {
  margin-top: 38rpx;
}

.inventory-group__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 4rpx;
}

.inventory-group__title-wrap {
  display: flex;
  align-items: center;
}

.inventory-group__tick {
  width: 7rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 4rpx;
  background: #4d806b;
}

.inventory-group__tick--danger {
  background: #b44535;
}

.inventory-group__tick--urgent {
  background: #c35d31;
}

.inventory-group__tick--warning {
  background: #c0832d;
}

.inventory-group__title {
  color: #31473f;
  font-size: 25rpx;
  font-weight: 650;
  letter-spacing: 0.04em;
}

.inventory-group__count {
  color: #89958f;
  font-size: 22rpx;
}

.loading-list {
  padding-top: 12rpx;
}

.loading-row {
  display: flex;
  align-items: center;
  height: 126rpx;
  border-bottom: 2rpx solid #e4eae6;
}

.loading-row__date,
.loading-row__line {
  border-radius: 10rpx;
  background: #e1e8e4;
}

.loading-row__date {
  width: 78rpx;
  height: 78rpx;
  margin-right: 22rpx;
}

.loading-row__content {
  flex: 1;
}

.loading-row__line {
  width: 55%;
  height: 25rpx;
}

.loading-row__line--short {
  width: 35%;
  height: 18rpx;
  margin-top: 15rpx;
}

.load-more {
  padding: 38rpx 0 20rpx;
  color: #94a09a;
  font-size: 23rpx;
  text-align: center;
}

.home__bottom-space {
  height: 148rpx;
}

.add-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 236rpx;
  height: 92rpx;
  padding: 0 30rpx;
  border-radius: 46rpx;
  background: #245b49;
  box-shadow: 0 14rpx 34rpx rgba(26, 65, 52, 0.22);
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 92rpx;
}

.add-button__plus {
  margin-right: 8rpx;
  font-size: 36rpx;
  font-weight: 400;
}

@media (prefers-reduced-motion: reduce) {
  .inventory-row {
    transition: none;
  }
}

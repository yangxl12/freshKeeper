<view class="inventory page-shell">
  <view class="query-panel">
    <view class="search-box">
      <view class="line-icon line-icon--search search-box__icon" aria-hidden="true"></view>
      <input
        class="search-box__input"
        value="{{search}}"
        placeholder="搜索物品名称"
        placeholder-class="search-box__placeholder"
        confirm-type="search"
        bindinput="handleSearchInput"
      />
      <button wx:if="{{search}}" class="search-box__clear" bindtap="clearSearch" hover-class="pressable--pressed" aria-label="清空搜索">
        <view class="line-icon line-icon--close" aria-hidden="true"></view>
      </button>
    </view>

    <view class="filter-section">
      <text class="filter-section__label">种类</text>
      <view class="filter-grid" role="radiogroup" aria-label="按种类筛选">
        <button
          wx:for="{{categoryOptions}}"
          wx:key="value"
          wx:for-item="option"
          class="filter-option {{category === option.value ? 'filter-option--active' : ''}}"
          data-value="{{option.value}}"
          bindtap="selectCategory"
          hover-class="filter-option--pressed"
          role="radio"
          aria-selected="{{category === option.value}}"
          aria-label="{{option.label}}{{category === option.value ? '，已选中' : ''}}"
        >{{option.label}}</button>
      </view>
    </view>

    <view class="filter-section filter-section--status">
      <text class="filter-section__label">状态</text>
      <view class="filter-grid" role="radiogroup" aria-label="按状态筛选">
        <button
          wx:for="{{statusOptions}}"
          wx:key="value"
          wx:for-item="option"
          class="filter-option {{viewStatus === option.value ? 'filter-option--active' : ''}}"
          data-value="{{option.value}}"
          bindtap="selectStatus"
          hover-class="filter-option--pressed"
          role="radio"
          aria-selected="{{viewStatus === option.value}}"
          aria-label="{{option.label}}{{viewStatus === option.value ? '，已选中' : ''}}"
        >{{option.label}}</button>
      </view>
    </view>

    <view wx:if="{{hasActiveConditions}}" class="filter-actions">
      <text class="filter-actions__hint">搜索与筛选同时生效</text>
      <button class="filter-actions__clear" bindtap="resetFilters" hover-class="pressable--pressed">清除全部</button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-banner">
    <text class="error-banner__text">{{errorMessage}}</text>
    <button class="error-banner__action" bindtap="retry" hover-class="pressable--pressed">重试</button>
  </view>

  <view wx:if="{{loading}}" class="loading-list" aria-label="正在加载库存">
    <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="loading-row">
      <view class="loading-row__date"></view>
      <view class="loading-row__content">
        <view class="loading-row__line"></view>
        <view class="loading-row__line loading-row__line--short"></view>
      </view>
    </view>
  </view>

  <block wx:elif="{{items.length}}">
    <view class="flat-list">
      <inventory-row wx:for="{{items}}" wx:for-item="inventoryItem" wx:key="_id" item="{{inventoryItem}}" bind:select="openItem" />
    </view>

    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多…</view>
    <view wx:elif="{{loadMoreError}}" class="load-more load-more--error">
      <text>{{loadMoreError}}</text>
      <button class="load-more__retry" bindtap="retryLoadMore" hover-class="pressable--pressed">重试</button>
    </view>
    <view wx:elif="{{!nextCursor}}" class="load-more">已经到底了</view>
  </block>

  <empty-state
    wx:elif="{{!errorMessage}}"
    title="{{hasActiveConditions ? '没有匹配的物品' : '先记下第一件物品'}}"
    description="{{hasActiveConditions ? '保留了当前条件，可以清除后再试' : '只需名称和到期日期，之后随时可以补充'}}"
    action-text="{{hasActiveConditions ? '清除筛选' : '新增物品'}}"
    bind:action="handleEmptyAction"
  />

  <view class="inventory__bottom-space"></view>
  <button class="add-button" bindtap="addItem" hover-class="pressable--pressed" aria-label="新增物品">
    <text class="add-button__plus" aria-hidden="true">＋</text>
    <text>新增</text>
  </button>
</view>

.inventory { padding-top: 24rpx; }

.query-panel {
  padding: 24rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 20rpx;
  background: #ffffff;
}

.search-box {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 88rpx;
  padding-left: 20rpx;
  border: 2rpx solid #d7e1dc;
  border-radius: 16rpx;
  background: #f8faf8;
}

.search-box__icon { margin-right: 12rpx; color: #718079; }
.search-box__input { min-width: 0; height: 84rpx; flex: 1; color: #173b31; font-size: 27rpx; }
.search-box__placeholder { color: #84918b; }

.search-box__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  background: transparent;
  color: #84918b;
  line-height: 88rpx;
}

.filter-section { margin-top: 24rpx; }
.filter-section--status { margin-top: 20rpx; }
.filter-section__label { display: block; margin-bottom: 10rpx; color: #68766f; font-size: 22rpx; font-weight: 600; letter-spacing: 0.08em; }

.filter-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8rpx;
}

.filter-option {
  overflow: hidden;
  box-sizing: border-box;
  min-width: 0;
  height: 88rpx;
  margin: 0;
  padding: 0 2rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 13rpx;
  background: #ffffff;
  color: #62716a;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 84rpx;
  text-overflow: clip;
  white-space: nowrap;
}

.filter-option--active {
  border-color: #1f5d49;
  background: #e8f2ed;
  color: #174b3c;
  font-weight: 700;
}

.filter-option--pressed { opacity: 0.68; transform: scale(0.97); }

.filter-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #edf1ee;
}

.filter-actions__hint { color: #84918b; font-size: 21rpx; }

.filter-actions__clear {
  min-width: 112rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 8rpx;
  background: transparent;
  color: #1f5d49;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
}

.error-banner__text { max-width: 500rpx; color: #9e3e34; font-size: 24rpx; }

.error-banner__action {
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.inventory-group { margin-top: 44rpx; }
.inventory-group:first-child { margin-top: 34rpx; }

.inventory-group__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 6rpx;
}

.inventory-group__title { color: #173b31; font-size: 30rpx; font-weight: 650; }
.inventory-group__title--danger { color: #b84a3e; }
.inventory-group__title--urgent,
.inventory-group__title--warning { color: #a96524; }
.inventory-group__count { color: #84918b; font-family: "DIN Alternate", "Arial Narrow", sans-serif; font-size: 22rpx; }
.flat-list { margin-top: 28rpx; }

.loading-list { padding-top: 28rpx; }
.loading-row { display: flex; align-items: center; height: 126rpx; border-bottom: 2rpx solid #e4eae6; }
.loading-row__date,
.loading-row__line { border-radius: 10rpx; background: #e1e8e4; }
.loading-row__date { width: 82rpx; height: 76rpx; margin-right: 22rpx; }
.loading-row__content { flex: 1; }
.loading-row__line { width: 55%; height: 25rpx; }
.loading-row__line--short { width: 35%; height: 18rpx; margin-top: 15rpx; }

.load-more { padding: 38rpx 0 20rpx; color: #84918b; font-size: 22rpx; text-align: center; }
.load-more--error { color: #9e3e34; }
.load-more__retry { display: inline-block; min-width: 88rpx; height: 64rpx; margin: 0 0 0 8rpx; padding: 0 10rpx; background: transparent; color: #9e3e34; font-size: 22rpx; font-weight: 600; line-height: 64rpx; }
.inventory__bottom-space { height: 132rpx; }

.add-button {
  position: fixed;
  right: 32rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 44rpx;
  background: #1f5d49;
  box-shadow: 0 14rpx 30rpx rgba(23, 59, 49, 0.22);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.add-button__plus { margin-right: 6rpx; font-size: 34rpx; font-weight: 400; }

@media (max-width: 340px) {
  .query-panel { padding-right: 18rpx; padding-left: 18rpx; }
  .filter-grid { gap: 6rpx; }
  .filter-option { font-size: 20rpx; }
}

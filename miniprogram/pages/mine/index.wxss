.mine {
  padding-top: 30rpx;
  padding-bottom: calc(174rpx + env(safe-area-inset-bottom));
}

/* 资料卡 */
.profile {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(23, 59, 49, 0.06);
}

.profile--pressed {
  opacity: 0.82;
}

.profile__avatar {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  flex: 0 0 auto;
  align-items: flex-end;
  justify-content: center;
  width: 116rpx;
  height: 116rpx;
  margin-right: 26rpx;
  border-radius: 50%;
  background: #e8f2ed;
}

.profile__avatar--default { background: #eef2f0; }

.profile__avatar-image,
.profile-editor__image {
  width: 100%;
  height: 100%;
}

.profile__avatar-head {
  width: 38rpx;
  height: 38rpx;
  margin-bottom: 6rpx;
  border-radius: 50%;
  background: #a9b8b1;
}

.profile__avatar-body {
  position: absolute;
  bottom: -18rpx;
  width: 74rpx;
  height: 46rpx;
  border-radius: 37rpx 37rpx 0 0;
  background: #a9b8b1;
}

.profile__info { min-width: 0; flex: 1; }

.profile__name {
  display: block;
  color: #173b31;
  font-size: 34rpx;
  font-weight: 700;
}

.profile__hint {
  display: block;
  margin-top: 8rpx;
  color: #84918b;
  font-size: 22rpx;
}

/* 入口列表 */
.entries {
  margin-top: 28rpx;
  overflow: hidden;
  border: 2rpx solid #e3eae6;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(23, 59, 49, 0.045);
}

.entry {
  display: flex;
  align-items: center;
  width: 100%;
  height: 116rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 0;
  background: #ffffff;
  text-align: left;
}

.entry + .entry { border-top: 2rpx solid #f1f5f3; }

.entry--pressed { background: #f5f9f7; }

.entry__icon {
  position: relative;
  box-sizing: border-box;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 auto;
  margin-right: 22rpx;
  border-radius: 16rpx;
  background: #eef4f1;
}

.entry__icon::before,
.entry__icon::after {
  position: absolute;
  content: "";
}

.entry__icon--bell::before {
  top: 15rpx;
  left: 18rpx;
  width: 16rpx;
  height: 16rpx;
  border-top-left-radius: 16rpx;
  border-top-right-radius: 16rpx;
  background: #1f5d49;
}

.entry__icon--bell::after {
  bottom: 12rpx;
  left: 22rpx;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #1f5d49;
}

.entry__icon--trash::before {
  top: 16rpx;
  left: 17rpx;
  width: 18rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #6b7a73;
}

.entry__icon--trash::after {
  top: 22rpx;
  left: 19rpx;
  box-sizing: border-box;
  width: 14rpx;
  height: 18rpx;
  border: 3rpx solid #6b7a73;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
}

.entry__icon--feedback::before {
  top: 16rpx;
  left: 15rpx;
  box-sizing: border-box;
  width: 24rpx;
  height: 17rpx;
  border: 3rpx solid #1f5d49;
  border-radius: 4rpx;
  background: transparent;
}

.entry__icon--feedback::after {
  bottom: 14rpx;
  left: 19rpx;
  width: 14rpx;
  height: 3rpx;
  background: #1f5d49;
}

.entry__icon--help::before {
  top: 14rpx;
  left: 17rpx;
  color: #1f5d49;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  content: "?";
}

.entry__icon--about::before {
  top: 12rpx;
  left: 22rpx;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #1f5d49;
}

.entry__icon--about::after {
  top: 22rpx;
  left: 22rpx;
  width: 5rpx;
  height: 18rpx;
  border-radius: 3rpx;
  background: #1f5d49;
}

.entry__icon--account { background: #fdf1ef; }

.entry__icon--account::before {
  top: 14rpx;
  left: 19rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b84a3e;
}

.entry__icon--account::after {
  top: 28rpx;
  left: 15rpx;
  width: 22rpx;
  height: 12rpx;
  border-radius: 11rpx 11rpx 0 0;
  background: #b84a3e;
}

.entry__label {
  flex: 0 0 auto;
  color: #173b31;
  font-size: 29rpx;
  font-weight: 600;
}

.entry__label--danger { color: #b84a3e; }

.entry__value {
  overflow: hidden;
  flex: 1;
  margin-left: 18rpx;
  color: #93a099;
  font-size: 22rpx;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry__chevron {
  box-sizing: border-box;
  width: 14rpx;
  height: 14rpx;
  flex: 0 0 auto;
  margin-left: 16rpx;
  border-top: 3rpx solid #c3cec9;
  border-right: 3rpx solid #c3cec9;
  transform: rotate(45deg);
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(18, 38, 32, 0.38);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  max-height: 82vh;
  overflow: hidden;
  padding: 34rpx 30rpx 28rpx;
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 50rpx rgba(18, 38, 32, 0.2);
}

.modal--large {
  display: flex;
  flex-direction: column;
  height: 76vh;
}

.modal__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.modal__title {
  display: block;
  color: #173b31;
  font-size: 33rpx;
  font-weight: 700;
}

.modal__subtitle {
  display: block;
  margin-top: 8rpx;
  color: #84918b;
  font-size: 23rpx;
}

.modal__hint {
  display: block;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #eef6f1;
  color: #2f6b57;
  font-size: 24rpx;
  line-height: 34rpx;
}

.modal__close {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  background: transparent;
  color: #84918b;
  font-size: 40rpx;
  line-height: 60rpx;
}

.modal__loading {
  padding: 40rpx 0;
  color: #84918b;
  font-size: 25rpx;
  text-align: center;
}

.modal__actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.modal__button { flex: 1; margin: 0; min-height: 88rpx; line-height: 88rpx; }

/* 不在 .modal__actions 里的按钮（导出 + 注销）自己撑满并留出间距。 */
.modal__button--stacked { flex: none; width: 100%; margin-top: 16rpx; }

/* 资料编辑 */
.profile-editor {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 26rpx 0 24rpx;
}

.profile-editor__avatar {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 148rpx;
  height: 148rpx;
  padding: 0;
  border: 4rpx dashed #cbd8d2;
  border-radius: 50%;
  background: #f5f9f7;
}

.profile-editor__avatar--pressed { opacity: 0.8; }

.profile-editor__placeholder {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.profile-editor__tip {
  margin-top: 14rpx;
  color: #1f5d49;
  font-size: 23rpx;
}

.field-label { margin-top: 8rpx; }

/* 设置行 */
.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  margin-top: 12rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f5f3;
}

.setting-row__label {
  display: block;
  color: #173b31;
  font-size: 27rpx;
  font-weight: 600;
}

.setting-row__description {
  display: block;
  margin-top: 6rpx;
  color: #84918b;
  font-size: 22rpx;
}

.setting-row__value {
  display: flex;
  align-items: center;
  color: #1f5d49;
  font-size: 26rpx;
  font-weight: 600;
}

/* 微信通知行：状态由微信系统下发，小程序侧只读，右边只给一个跳转入口。 */
.setting-row--static {
  align-items: flex-start;
}

.setting-row__main {
  min-width: 0;
  flex: 1;
}

.setting-row__action {
  flex: 0 0 auto;
  margin: 0 0 0 16rpx;
  padding: 0 24rpx;
  height: 64rpx;
  border: 2rpx solid #cddcd4;
  border-radius: 16rpx;
  background: #ffffff;
  color: #1f5d49;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.setting-row__chevron { margin-left: 10rpx; color: #93a099; }

.compact-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
  color: #9e3e34;
  font-size: 23rpx;
}

.compact-error button {
  min-width: 88rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 8rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 64rpx;
}

/* 回收站 */
.search-box {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 80rpx;
  margin-top: 20rpx;
  padding-left: 20rpx;
  border: 2rpx solid #dde6e1;
  border-radius: 999rpx;
  background: #f7faf8;
}

.search-box__icon { margin-right: 12rpx; color: #718079; }
.search-box__input { min-width: 0; height: 76rpx; flex: 1; color: #173b31; font-size: 27rpx; }
.search-box__placeholder { color: #84918b; }

.search-box__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  padding: 0;
  background: transparent;
  color: #84918b;
}

.trash-body {
  flex: 1;
  min-height: 0;
  margin-top: 16rpx;
}

.trash-item { margin-bottom: 12rpx; }

.trash-item__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: -6rpx;
  padding: 0 6rpx 6rpx;
}

.trash-item__meta text { color: #93a099; font-size: 21rpx; }

.trash-item__meta button {
  min-width: 120rpx;
  height: 60rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #b84a3e;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 60rpx;
}

.trash-tip {
  padding: 48rpx 0;
  color: #84918b;
  font-size: 24rpx;
  text-align: center;
}

.trash-more {
  width: 100%;
  min-height: 80rpx;
  margin: 8rpx 0 20rpx;
  border: 2rpx solid #cbd8d2;
  border-radius: 14rpx;
  background: #ffffff;
  color: #1f5d49;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 76rpx;
}

/* 到达单次加载上限（200 条）后的说明，和「加载更多」按钮同一位置但不该是可点样式。 */
.trash-more--limited {
  border-color: transparent;
  background: transparent;
  color: #93a49f;
  font-size: 21rpx;
  font-weight: 400;
  text-align: center;
}

/* 批量管理的入口，固定在弹窗底部，不跟着列表滚动。 */
.trash-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #eef3f0;
}

.trash-foot__hint {
  min-width: 0;
  color: #84918b;
  flex: 1;
  font-size: 22rpx;
}

.trash-foot__batch {
  min-width: 180rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 26rpx;
  border: 2rpx solid #cbd8d2;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1f5d49;
  flex: 0 0 auto;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 74rpx;
}

.trash-foot__batch[disabled] { opacity: 0.42; }

/* 反馈 / 帮助 / 关于 */
.feedback-input {
  box-sizing: border-box;
  width: 100%;
  height: 240rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 16rpx;
  background: #fbfdfc;
  color: #173b31;
  font-size: 26rpx;
  line-height: 1.6;
}

.help-list { margin-top: 20rpx; }

.help-item {
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f5f3;
}

.help-item:last-child { border-bottom: 0; }

.help-item__q {
  display: block;
  color: #173b31;
  font-size: 26rpx;
  font-weight: 650;
}

.help-item__a {
  display: block;
  margin-top: 8rpx;
  color: #6b7a73;
  font-size: 24rpx;
  line-height: 1.6;
}

.about {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 8rpx;
}

.about__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 18rpx;
  border-radius: 28rpx;
  background: #1f5d49;
}

.about__logo-text {
  color: #ffffff;
  font-family: "Songti SC", "STSong", serif;
  font-size: 52rpx;
  font-weight: 700;
}

@media (max-width: 340px) {
  .entry__label { font-size: 27rpx; }
  .entry__value { font-size: 20rpx; }
}

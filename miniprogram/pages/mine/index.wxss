.settings-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 132rpx;
  margin: 0;
  padding: 26rpx 28rpx;
  border: 2rpx solid #d7e2dc;
  border-radius: 14rpx;
  background: #1f5d49;
  box-shadow: 0 10rpx 28rpx rgba(23, 59, 49, 0.12);
  color: #ffffff;
  text-align: left;
}

.settings-entry__title,
.settings-entry__value {
  display: block;
}

.settings-entry__title {
  font-size: 29rpx;
  font-weight: 700;
}

.settings-entry__value {
  margin-top: 5rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
}

.settings-entry__action {
  padding: 10rpx 18rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 8rpx;
  font-size: 23rpx;
  font-weight: 650;
}

.records {
  margin-top: 42rpx;
}

.record-tabs {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  padding-bottom: 4rpx;
  border-bottom: 2rpx solid #dce4e0;
}

.record-tab {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 50%;
  min-width: 0;
  max-width: 50%;
  min-height: 76rpx;
  flex: 0 0 50%;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #7a8881;
  font-size: 26rpx;
  line-height: 1;
  text-align: center;
}

.record-tab--active {
  color: #173b31;
  font-weight: 700;
}

.record-tab--active::after {
  position: absolute;
  bottom: -4rpx;
  left: 50%;
  width: 32%;
  height: 6rpx;
  border-radius: 3rpx;
  background: #1f5d49;
  content: "";
  transform: translateX(-50%);
}

.records__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 34rpx;
}

.records__title,
.records__hint {
  display: block;
}

.records__title {
  color: #173b31;
  font-size: 32rpx;
  font-weight: 700;
}

.records__hint {
  margin-top: 3rpx;
  color: #84918b;
  font-size: 21rpx;
}

.records__batch {
  min-width: 136rpx;
  min-height: 66rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid #cbd8d2;
  border-radius: 9rpx;
  background: #ffffff;
  color: #1f5d49;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 64rpx;
}

.records__batch[disabled] {
  opacity: 0.42;
}

.record-search {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  height: 88rpx;
  margin-top: 22rpx;
  padding-left: 22rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 12rpx;
  background: #ffffff;
}

.record-search__icon {
  margin-right: 14rpx;
  color: #718079;
}

.record-search__input {
  min-width: 0;
  height: 84rpx;
  flex: 1;
  color: #173b31;
  font-size: 26rpx;
}

.record-search__placeholder {
  color: #84918b;
}

.record-search__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  padding: 0;
  background: transparent;
  color: #84918b;
}

.record-item {
  position: relative;
  margin-top: 18rpx;
}

.record-item inventory-row .inventory-row {
  margin-bottom: 0;
}

.trash-row-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: -18rpx;
  padding: 14rpx 18rpx 12rpx;
  border: 2rpx solid #e8d8d4;
  border-top: 0;
  border-radius: 0 0 12rpx 12rpx;
  background: #fff8f6;
  color: #8d6f69;
  font-size: 21rpx;
}

.trash-row-meta button {
  min-height: 60rpx;
  margin: 0;
  padding: 0 10rpx;
  background: transparent;
  color: #b84a3e;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 60rpx;
}

.record-loading,
.settings-loading {
  padding: 70rpx 0;
  color: #74817b;
  font-size: 24rpx;
  text-align: center;
}

.record-loading--more {
  padding: 30rpx 0;
}

.record-end {
  padding: 34rpx 0;
  color: #84918b;
  font-size: 22rpx;
  text-align: center;
}

.compact-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 0;
  padding: 18rpx 20rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
  color: #9e3e34;
  font-size: 23rpx;
}

.compact-error button {
  height: 64rpx;
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: #9e3e34;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 64rpx;
}

.settings-modal {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  padding: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(12, 29, 24, 0.46);
}

.settings-dialog {
  box-sizing: border-box;
  width: 100%;
  padding: 32rpx 28rpx 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 70rpx rgba(12, 29, 24, 0.2);
}

.settings-dialog__heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid #e4eae7;
}

.settings-dialog__title,
.settings-dialog__subtitle {
  display: block;
}

.settings-dialog__title {
  color: #173b31;
  font-size: 33rpx;
  font-weight: 700;
}

.settings-dialog__subtitle {
  margin-top: 4rpx;
  color: #84918b;
  font-size: 21rpx;
}

.settings-dialog__close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: -8rpx -8rpx 0 0;
  padding: 0;
  border-radius: 50%;
  background: #f0f3f1;
  color: #64736c;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 64rpx;
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 124rpx;
  border-bottom: 2rpx solid #e5ebe7;
}

.setting-row--notification {
  min-height: 142rpx;
}

.setting-row__label,
.setting-row__description {
  display: block;
}

.setting-row__label {
  color: #30473e;
  font-size: 26rpx;
  font-weight: 650;
}

.setting-row__description {
  max-width: 380rpx;
  margin-top: 4rpx;
  color: #84918b;
  font-size: 21rpx;
}

.setting-row__value {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
  color: #1f5d49;
  font-size: 24rpx;
}

.setting-row__chevron {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  color: #a1ada7;
}

.setting-row__link {
  min-width: 116rpx;
  height: 72rpx;
  margin: 0 0 0 12rpx;
  padding: 0 8rpx;
  background: transparent;
  color: #1f5d49;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 72rpx;
}

.settings-dialog__actions {
  display: grid;
  grid-template-columns: 1fr 1.35fr;
  gap: 14rpx;
  margin-top: 26rpx;
}

.settings-dialog__actions button {
  margin: 0;
}

@media (max-width: 340px) {
  .setting-row__description {
    max-width: 300rpx;
  }
}

page {
  min-height: 100%;
  background: #f5f6f2;
  color: #173b31;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    sans-serif;
  font-size: 26rpx;
  line-height: 1.5;
}

button,
input,
textarea {
  font: inherit;
}

button::after {
  border: 0;
}

button {
  transition: opacity 120ms ease, transform 120ms ease;
}

.pressable--pressed {
  opacity: 0.72;
  transform: scale(0.985);
}

button:focus,
input:focus {
  outline: 4rpx solid rgba(36, 91, 73, 0.3);
  outline-offset: 2rpx;
}

.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.section-title {
  color: #53645d;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
}

.primary-button,
.secondary-button,
.danger-button {
  min-height: 92rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.primary-button {
  background: #1f5d49;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #aab6b1;
  color: #eef2ef;
}

.secondary-button {
  border: 2rpx solid #cbd8d2;
  background: #ffffff;
  color: #1f5d49;
}

.secondary-button[disabled] {
  border-color: #e3ebe7;
  background: #f7f9f9;
  color: #a9b5b0;
}

.danger-button {
  border: 2rpx solid #dfb9b3;
  background: transparent;
  color: #b84a3e;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #53645d;
  font-size: 25rpx;
  font-weight: 600;
}

.field-control {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 16rpx;
  background: #ffffff;
  color: #173b31;
}

.field-placeholder {
  color: #84918b;
}

.feedback-error {
  margin: 24rpx 0;
  padding: 22rpx 24rpx;
  border-left: 6rpx solid #b84a3e;
  background: #fff4f1;
  color: #9e3e34;
  font-size: 26rpx;
}

.line-icon {
  position: relative;
  display: inline-block;
  box-sizing: border-box;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
  color: currentColor;
}

.line-icon--search::before {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  box-sizing: border-box;
  width: 20rpx;
  height: 20rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  content: "";
}

.line-icon--search::after {
  position: absolute;
  right: 3rpx;
  bottom: 5rpx;
  width: 11rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
  transform: rotate(45deg);
  transform-origin: right center;
}

.line-icon--close::before,
.line-icon--close::after {
  position: absolute;
  top: 15rpx;
  left: 6rpx;
  width: 20rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.line-icon--close::before {
  transform: rotate(45deg);
}

.line-icon--close::after {
  transform: rotate(-45deg);
}

.line-icon--chevron::before {
  position: absolute;
  top: 9rpx;
  left: 10rpx;
  box-sizing: border-box;
  width: 12rpx;
  height: 12rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(45deg);
}

.line-icon--chevron-right::before {
  transform: rotate(-45deg);
}

.line-icon--calendar {
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}

.line-icon--calendar::before {
  position: absolute;
  top: 7rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.line-icon--calendar::after {
  position: absolute;
  top: -5rpx;
  left: 7rpx;
  width: 14rpx;
  height: 7rpx;
  border-right: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
}

.line-icon--edit {
  width: 28rpx;
  height: 28rpx;
  border-bottom: 2rpx solid currentColor;
}

.line-icon--edit::before {
  position: absolute;
  top: 2rpx;
  left: 13rpx;
  width: 7rpx;
  height: 22rpx;
  border: 2rpx solid currentColor;
  border-radius: 3rpx 3rpx 0 0;
  content: "";
  transform: rotate(42deg);
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@media (prefers-reduced-motion: reduce) {
  button {
    transition: none;
  }
}

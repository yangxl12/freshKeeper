button {
  margin: 0;
  padding: 0;
  background: transparent;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

.tabbar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 900;
  overflow: visible;
  padding-bottom: env(safe-area-inset-bottom);
  border-radius: 28rpx 28rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -6rpx 26rpx rgba(23, 59, 49, 0.07);
  transition: opacity 180ms ease, transform 180ms ease;
}

/* 弹窗打开时下沉收起，保证遮罩与弹窗始终位于标签栏之上 */
.tabbar--hidden {
  opacity: 0;
  transform: translateY(120%);
  pointer-events: none;
}

.tabbar__bar {
  display: flex;
  align-items: stretch;
  height: 104rpx;
}

.tabbar__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 104rpx;
}

.tabbar__icon {
  width: 44rpx;
  height: 44rpx;
}

.tabbar__label {
  margin-top: 6rpx;
  color: #929e98;
  font-size: 20rpx;
  letter-spacing: 0.04em;
}

.tabbar__item--active .tabbar__label {
  color: #176348;
  font-weight: 700;
}

.tabbar__add-slot {
  flex: 0 0 150rpx;
  height: 104rpx;
}

/* 悬浮在 bar 之上的新增按钮：单独定位 + 允许溢出，避免被按钮/容器裁掉凸起部分 */
.tabbar__add {
  position: fixed;
  right: 0;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto;
  overflow: visible;
  background: transparent;
}

.tabbar__add-circle {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 7rpx solid #ffffff;
  background: radial-gradient(circle at 25% 15%, #76b89d, #2e8769 55%, #267258);
  box-shadow: 0 6rpx 22rpx rgba(39,114,88,.12);
  transition: opacity 120ms ease, transform 120ms ease;
}

.tabbar__add-plus {
  color: #ffffff;
  font-size: 64rpx;
  font-weight: 300;
  line-height: 1;
}

.tabbar__add--pressed .tabbar__add-circle {
  opacity: 0.78;
  transform: scale(0.94);
}

@media (prefers-reduced-motion: reduce) {
  .tabbar,
  .tabbar__add-circle {
    transition: none;
  }
}

.tabbar__add-slot { position: relative; }
.tabbar__add-label { position: absolute; bottom: 9rpx; left: 0; right: 0; text-align: center; color: #83918e; font-size: 20rpx; }

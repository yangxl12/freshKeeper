<view class="form-sheet-page">
  <view wx:if="{{errorMessage}}" class="feedback-error" role="alert">
    <text>{{errorMessage}}</text>
    <button wx:if="{{loadFailed}}" class="inline-retry" bindtap="retryLoad">重新加载</button>
  </view>

  <view wx:if="{{loading}}" class="form-loading">正在读取物品信息…</view>

  <block wx:elif="{{!loadFailed}}">
    <view class="form-sheet">
      <view class="form-card">
        <view class="form-row form-row--name">
          <text class="form-row__label">物品名称 <text class="required-mark">*</text></text>
          <view class="form-row__content form-row__content--stacked">
            <input
              class="form-row__input form-row__input--name"
              value="{{name}}"
              maxlength="40"
              placeholder="请输入物品名称"
              placeholder-class="field-placeholder"
              data-field="name"
              bindinput="handleTextInput"
            />
            <text class="field-count">{{name.length}}/40</text>
          </view>
        </view>

        <view class="form-row form-row--mode">
          <text class="form-row__label">到期计算 <text class="required-mark">*</text></text>
          <view class="mode-switch" role="tablist">
            <button
              class="mode-switch__item {{mode === 'direct' ? 'mode-switch__item--active' : ''}}"
              data-mode="direct"
              bindtap="handleModeChange"
              aria-selected="{{mode === 'direct'}}"
            >到期日期</button>
            <button
              class="mode-switch__item {{mode === 'shelf_life' ? 'mode-switch__item--active' : ''}}"
              data-mode="shelf_life"
              bindtap="handleModeChange"
              aria-selected="{{mode === 'shelf_life'}}"
            >保质期计算</button>
          </view>
        </view>

        <view wx:if="{{mode === 'direct'}}" class="form-row form-row--picker">
          <text class="form-row__label">到期日期 <text class="required-mark">*</text></text>
          <picker class="form-row__picker" mode="date" value="{{expiryDate}}" end="2200-12-31" data-field="expiryDate" bindchange="handleDateChange">
            <view class="form-row__picker-value {{!expiryDate ? 'field-placeholder' : ''}}">
              <text>{{expiryDate || '请选择日期'}}</text>
              <view class="line-icon line-icon--calendar form-row__calendar" aria-hidden="true"></view>
            </view>
          </picker>
        </view>

        <block wx:else>
          <view class="form-row form-row--picker">
            <text class="form-row__label">生产日期 <text class="required-mark">*</text></text>
            <picker class="form-row__picker" mode="date" value="{{productionDate}}" end="{{today}}" data-field="productionDate" bindchange="handleDateChange">
              <view class="form-row__picker-value {{!productionDate ? 'field-placeholder' : ''}}">
                <text>{{productionDate || '请选择日期'}}</text>
                <view class="line-icon line-icon--calendar form-row__calendar" aria-hidden="true"></view>
              </view>
            </picker>
          </view>

          <view class="form-row">
            <text class="form-row__label">保质期 <text class="required-mark">*</text></text>
            <view class="shelf-life-control">
              <input
                class="form-row__input shelf-life-control__input"
                value="{{shelfLifeValue}}"
                type="number"
                placeholder="请输入时长"
                placeholder-class="field-placeholder"
                maxlength="5"
                data-field="shelfLifeValue"
                bindinput="handleTextInput"
              />
              <picker class="shelf-life-control__unit" mode="selector" range="{{shelfLifeOptions}}" range-key="label" value="{{shelfLifeUnitIndex}}" bindchange="handleShelfLifeUnitChange">
                <view class="shelf-life-control__unit-value">
                  <text>{{shelfLifeOptions[shelfLifeUnitIndex].label}}</text>
                  <view class="line-icon line-icon--chevron form-row__unit-arrow" aria-hidden="true"></view>
                </view>
              </picker>
            </view>
          </view>

          <view class="form-row form-row--preview">
            <text class="form-row__label">预计到期</text>
            <text class="expiry-preview__date {{expiryPreview ? 'expiry-preview__date--ready' : ''}}">{{expiryPreview || '填写后自动计算'}}</text>
          </view>
        </block>

        <view class="form-row">
          <text class="form-row__label">提前提醒 <text class="required-mark">*</text></text>
          <view class="number-suffix-control {{reminderEnabled ? '' : 'number-suffix-control--disabled'}}">
            <input
              class="number-suffix-control__input"
              value="{{reminderLeadDays}}"
              type="number"
              maxlength="2"
              disabled="{{!reminderEnabled}}"
              data-field="reminderLeadDays"
              bindinput="handleTextInput"
            />
            <text class="number-suffix-control__suffix">天</text>
          </view>
          <switch
            class="reminder-switch"
            checked="{{reminderEnabled}}"
            color="#24684f"
            aria-label="开启或关闭提醒"
            bindchange="handleReminderSwitch"
          />
        </view>

        <view class="form-row">
          <text class="form-row__label">数量 <text class="required-mark">*</text></text>
          <input
            class="form-row__input form-row__input--quantity"
            value="{{quantity}}"
            type="number"
            maxlength="4"
            placeholder="请输入数量"
            placeholder-class="field-placeholder"
            data-field="quantity"
            bindinput="handleTextInput"
          />
          <input
            class="quantity-unit-input"
            value="{{unit}}"
            maxlength="8"
            placeholder="件"
            placeholder-class="field-placeholder"
            data-field="unit"
            bindinput="handleTextInput"
          />
        </view>

        <view class="form-row form-row--picker">
          <text class="form-row__label">分类 <text class="required-mark">*</text></text>
          <picker class="form-row__picker" mode="selector" range="{{categoryOptions}}" range-key="label" value="{{categoryIndex}}" bindchange="handleCategoryChange">
            <view class="form-row__picker-value">
              <text>{{categoryOptions[categoryIndex].label}}</text>
              <view class="line-icon line-icon--chevron-right form-row__arrow" aria-hidden="true"></view>
            </view>
          </picker>
        </view>

        <view class="form-row form-row--location">
          <text class="form-row__label">存放位置</text>
          <input
            class="form-row__input"
            value="{{storageLocation}}"
            placeholder="如：冰箱、床头柜（选填）"
            placeholder-class="field-placeholder"
            data-field="storageLocation"
            bindinput="handleTextInput"
          />
        </view>
      </view>

      <text class="form-hint">保存后可在物品详情中单独开启微信提醒</text>
    </view>

    <view class="save-bar">
      <button class="primary-button save-button" disabled="{{saving}}" bindtap="save" hover-class="pressable--pressed">
        {{saving ? '正在保存…' : (restoring ? '确认重新入库' : (itemId ? '保存修改' : '加入库存'))}}
      </button>
    </view>
  </block>

  <!-- 提醒设置弹窗（与「我的—提醒设置」同款） -->
  <view wx:if="{{reminderSettingsVisible}}" class="modal-mask" bindtap="closeReminderSettings" catchtouchmove="noop">
    <view class="modal" catchtap="stopPropagation" role="dialog" aria-modal="true" aria-label="提醒设置">
      <text class="modal__title">提醒设置</text>
      <text class="modal__subtitle">用于新增物品和微信通知</text>

      <picker
        disabled="{{reminderSaving}}"
        mode="selector"
        range="{{reminderDayOptions}}"
        range-key="label"
        value="{{reminderDayIndex}}"
        bindchange="handleReminderDaysChange"
      >
        <view class="modal-setting-row">
          <view>
            <text class="modal-setting-row__label">默认提前提醒</text>
            <text class="modal-setting-row__description">新增物品时自动带入</text>
          </view>
          <view class="modal-setting-row__value">
            <text>{{reminderDayOptions[reminderDayIndex].label}}</text>
            <view class="line-icon line-icon--chevron-right modal-setting-row__chevron" aria-hidden="true"></view>
          </view>
        </view>
      </picker>

      <view class="modal__actions">
        <button class="secondary-button modal__button" disabled="{{reminderSaving}}" bindtap="closeReminderSettings" hover-class="pressable--pressed">取消</button>
        <button class="primary-button modal__button" disabled="{{reminderSaving}}" bindtap="saveReminderSettings" hover-class="pressable--pressed">{{reminderSaving ? '保存中…' : '保存'}}</button>
      </view>
    </view>
  </view>
</view>

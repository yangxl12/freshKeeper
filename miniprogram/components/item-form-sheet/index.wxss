/* 完整录入、编辑和重新入库共用的轻量表单。 */
.form-sheet-page {
  padding-bottom: calc(154rpx + env(safe-area-inset-bottom));
}

/* 宿主自带底部按钮（草稿编辑弹窗）：不留 save-bar 的占位。 */
.form-sheet-page--inline {
  padding-bottom: 0;
}/* 必须用裸标签选择器（组件默认样式隔离，不会外泄）。
   若写成 `.form-sheet-page button`（特异性 0,1,1），会盖过下面的
   .primary-button / .mode-switch__item（0,1,0），把 font-size / font-weight /
   line-height 一并重置为继承值，表现为按钮文字贴顶、不垂直居中。 */
button,
input,
textarea {
  font: inherit;
}

button::after {
  border: 0;
}

button {
  transition: opacity 120ms ease, transform 120ms ease;
}

.pressable--pressed {
  opacity: 0.76;
  transform: scale(0.99);
}

.feedback-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff1ee;
  color: #a4473c;
  font-size: 24rpx;
}

.inline-retry {
  flex-shrink: 0;
  margin: 0;
  padding: 0 12rpx;
  background: transparent;
  color: #963c33;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 56rpx;
}

.form-loading {
  padding: 220rpx 0;
  color: #87938e;
  text-align: center;
}

.form-sheet {
  padding-top: 2rpx;
}

.form-card {
  overflow: hidden;
  padding: 0 26rpx;
  border: 2rpx solid #e8ece9;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 30rpx rgba(40, 66, 56, 0.045);
}

.form-row {
  position: relative;
  display: flex;
  box-sizing: border-box;
  min-height: 104rpx;
  align-items: center;
  gap: 18rpx;
  border-bottom: 2rpx solid #edf0ee;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-row--name {
  min-height: 136rpx;
  align-items: flex-start;
  padding-top: 29rpx;
}

.form-row--mode {
  min-height: 122rpx;
}

.form-row__label {
  width: 178rpx;
  flex: 0 0 178rpx;
  color: #344a42;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.45;
}

.required-mark {
  color: #c45b50;
  font-size: 22rpx;
}

.form-row__content {
  min-width: 0;
  flex: 1;
}

.form-row__content--stacked {
  position: relative;
  padding-bottom: 34rpx;
}

.form-row__input {
  box-sizing: border-box;
  width: 100%;
  height: 100rpx;
  min-width: 0;
  padding: 0;
  color: #213b32;
  font-size: 27rpx;
}

.form-row__input--name {
  height: 58rpx;
}

.field-placeholder {
  color: #a8afac;
}

.field-count {
  position: absolute;
  right: 0;
  bottom: 12rpx;
  color: #b0b7b4;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.form-row__picker {
  min-width: 0;
  flex: 1;
}

.form-row__picker-value {
  display: flex;
  min-height: 100rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  color: #213b32;
  font-size: 27rpx;
}

.form-row__arrow {
  width: 24rpx;
  height: 24rpx;
  color: #9aa39f;
}

.form-row__arrow::before {
  top: 6rpx;
  left: 5rpx;
  width: 9rpx;
  height: 9rpx;
}

.form-row__calendar {
  width: 27rpx;
  height: 27rpx;
  color: #668078;
}

.mode-switch {
  display: flex;
  min-width: 0;
  flex: 1;
  padding: 6rpx;
  border-radius: 15rpx;
  background: #f2f4f2;
}

.mode-switch__item {
  min-width: 0;
  min-height: 72rpx;
  flex: 1;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 11rpx;
  background: transparent;
  color: #7c8984;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 72rpx;
  white-space: nowrap;
}

.mode-switch__item--active {
  background: #ffffff;
  box-shadow: 0 3rpx 12rpx rgba(36, 65, 54, 0.08);
  color: #32735b;
  font-weight: 650;
}

.shelf-life-control {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.shelf-life-control__input {
  flex: 1;
}

.shelf-life-control__unit {
  flex: 0 0 112rpx;
}

.shelf-life-control__unit-value {
  display: flex;
  height: 100rpx;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  color: #53665e;
  font-size: 26rpx;
}

.form-row__unit-arrow {
  width: 22rpx;
  height: 22rpx;
  color: #9aa39f;
}

.form-row__unit-arrow::before {
  top: 5rpx;
  left: 6rpx;
  width: 8rpx;
  height: 8rpx;
}

.form-row--preview {
  min-height: 92rpx;
}

.expiry-preview__date {
  min-width: 0;
  flex: 1;
  color: #a6aeaa;
  font-size: 26rpx;
}

.expiry-preview__date--ready {
  color: #32735b;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.number-suffix-control {
  display: flex;
  min-width: 0;
  height: 100rpx;
  flex: 1;
  align-items: center;
}

.number-suffix-control__input {
  height: 100rpx;
  min-width: 0;
  flex: 1;
  color: #213b32;
  font-size: 27rpx;
}

.number-suffix-control__suffix {
  color: #7b8782;
  font-size: 25rpx;
}

.number-suffix-control--disabled {
  opacity: 0.45;
}

/* 提醒授权行：开关贴右；授权状态来自微信系统，开关本身不接收写入。 */
.reminder-auth {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
}

.reminder-switch {
  flex: 0 0 auto;
  margin-left: 4rpx;
  transform: scale(0.78);
  transform-origin: right center;
}

/* 数量行：主输入占满剩余空间，单位小输入框固定宽度贴右。 */
.form-row__input--quantity {
  width: auto;
  flex: 1;
  min-width: 0;
}

.quantity-unit-input {
  box-sizing: border-box;
  width: 128rpx;
  height: 64rpx;
  flex: 0 0 128rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #f2f4f2;
  color: #213b32;
  font-size: 25rpx;
  text-align: center;
}

/* 提醒设置弹窗（与「我的」页同款布局，组件样式隔离需自带一份） */
.modal-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  background: rgba(15, 27, 22, 0.45);
}

.modal {
  box-sizing: border-box;
  width: 100%;
  max-width: 620rpx;
  padding: 40rpx 36rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 20rpx 60rpx rgba(24, 48, 38, 0.22);
}

.modal__title {
  display: block;
  color: #213b32;
  font-size: 33rpx;
  font-weight: 650;
  text-align: center;
}

.modal__subtitle {
  display: block;
  margin-top: 10rpx;
  margin-bottom: 26rpx;
  color: #8a948f;
  font-size: 23rpx;
  text-align: center;
}

.modal-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 4rpx;
  border-bottom: 2rpx solid #edf0ee;
}

.modal-setting-row__label {
  display: block;
  color: #344a42;
  font-size: 27rpx;
  font-weight: 500;
}

.modal-setting-row__description {
  display: block;
  margin-top: 6rpx;
  color: #98a09d;
  font-size: 21rpx;
}

.modal-setting-row__value {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #213b32;
  font-size: 26rpx;
}

.modal-setting-row__chevron {
  width: 22rpx;
  height: 22rpx;
  color: #9aa39f;
}

.modal-setting-row__chevron::before {
  top: 5rpx;
  left: 6rpx;
  width: 8rpx;
  height: 8rpx;
}

/* 弹窗里的「提醒授权」行：文案占满左侧，右侧「查看设置」跳微信订阅设置页。 */
.modal-setting-row--notification {
  align-items: center;
}

.modal-setting-row__copy {
  min-width: 0;
  flex: 1;
}

.modal-setting-row__link {
  min-width: 120rpx;
  height: 64rpx;
  margin: 0 0 0 16rpx;
  padding: 0 10rpx;
  background: transparent;
  color: #1f5d49;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 64rpx;
}

.modal__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal__button {
  flex: 1;
  margin: 0;
  min-height: 84rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 84rpx;
}

.secondary-button {
  background: #f2f4f2;
  color: #4b5a54;
}

.form-hint {
  display: block;
  padding: 18rpx 8rpx 0;
  color: #98a09d;
  font-size: 21rpx;
  line-height: 1.55;
}

.save-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid rgba(223, 230, 226, 0.82);
  background: rgba(249, 250, 247, 0.96);
}

.primary-button {
  min-height: 92rpx;
  border-radius: 18rpx;
  background: #24684f;
  color: #ffffff;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 92rpx;
}

.primary-button[disabled] {
  background: #aebbb5;
  color: #eff3f1;
}

.save-button {
  width: 100%;
  margin: 0;
  box-shadow: 0 8rpx 22rpx rgba(36, 104, 79, 0.18);
}

.line-icon {
  position: relative;
  display: inline-block;
  box-sizing: border-box;
  flex: 0 0 auto;
  color: currentColor;
}

.line-icon--chevron::before,
.line-icon--chevron-right::before {
  position: absolute;
  box-sizing: border-box;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
}

.line-icon--chevron::before {
  transform: rotate(45deg);
}

.line-icon--chevron-right::before {
  transform: rotate(-45deg);
}

.line-icon--calendar {
  border: 2rpx solid currentColor;
  border-radius: 5rpx;
}

.line-icon--calendar::before {
  position: absolute;
  top: 6rpx;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.line-icon--calendar::after {
  position: absolute;
  top: -5rpx;
  left: 6rpx;
  width: 12rpx;
  height: 7rpx;
  border-right: 2rpx solid currentColor;
  border-left: 2rpx solid currentColor;
  content: "";
}

@media (max-width: 340px) {
  .form-card {
    padding: 0 22rpx;
  }

  .form-row {
    gap: 12rpx;
  }

  .form-row__label {
    width: 164rpx;
    flex-basis: 164rpx;
  }

  .mode-switch__item {
    font-size: 22rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .form-sheet-page button {
    transition: none;
  }
}

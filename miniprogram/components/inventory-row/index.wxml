<view
  class="inventory-row inventory-row--{{item.expiryTone}}"
  bindtap="handleTap"
  hover-class="inventory-row--pressed"
  role="button"
  aria-label="{{item.name}}，{{item.remainingDaysText}}，到期日期 {{item.expiryDateText}}，{{item.categoryLabel}}"
>
  <view class="inventory-row__headline">
    <text class="inventory-row__name">{{item.name}}</text>
    <text class="inventory-row__remaining">{{item.remainingDaysText}}</text>
  </view>
  <view class="inventory-row__details">
    <text class="inventory-row__expiry">{{item.expiryDateText}}</text>
    <text class="inventory-row__category">{{item.categoryLabel}}</text>
  </view>
</view>

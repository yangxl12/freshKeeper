<view class="item-card item-card--{{item.isActive ? item.expiryTone : 'muted'}}" bindtap="handleTap" hover-class="item-card--pressed" role="button" aria-label="{{item.name}}，{{item.categoryLabel}}{{item.hasLocation ? '，' + item.locationText : ''}}，{{item.isActive ? item.remainingDaysText : '已用完'}}，数量 {{item.quantityText}}">
  <image class="item-card__image" src="/assets/inventory-placeholder.svg" mode="aspectFit" aria-hidden="true" />
  <view class="item-card__body">
    <text class="item-card__name">{{item.name}}</text>
    <view class="item-card__meta">
      <text class="item-card__meta-text item-card__meta-text--category">{{item.categoryLabel}}</text>
      <block wx:if="{{item.hasLocation}}">
        <view class="item-card__meta-divider" aria-hidden="true"></view>
        <view class="item-card__meta-item item-card__meta-item--location">
          <view class="meta-icon meta-icon--pin" aria-hidden="true"></view>
          <text class="item-card__meta-text">{{item.locationText}}</text>
        </view>
      </block>
    </view>
  </view>
  <view class="item-card__side">
    <view class="item-card__remaining"><view class="clock-icon" aria-hidden="true"></view><text>{{item.isActive ? item.remainingDaysText : '已用完'}}</text></view>
    <view wx:if="{{item.isActive}}" class="item-card__stepper">
      <view class="item-card__step {{item.quantity <= 1 ? 'item-card__step--disabled' : ''}}" data-delta="-1" catchtap="handleQuantity" hover-class="item-card__step--pressed" role="button" aria-disabled="{{item.quantity <= 1}}" aria-label="减少数量">
        <view class="item-card__disc" aria-hidden="true">
          <view class="item-card__disc-bar"></view>
        </view>
      </view>
      <view class="item-card__quantity" catchtap="handleQuantity" hover-class="item-card__quantity--pressed" role="button" aria-label="调整数量 {{item.quantityText}}">
        <text class="item-card__quantity-value">{{item.quantity}}</text>
        <text class="item-card__quantity-unit">{{item.unit}}</text>
      </view>
      <view class="item-card__step {{item.quantity >= 9999 ? 'item-card__step--disabled' : ''}}" data-delta="1" catchtap="handleQuantity" hover-class="item-card__step--pressed" role="button" aria-disabled="{{item.quantity >= 9999}}" aria-label="增加数量">
        <view class="item-card__disc" aria-hidden="true">
          <view class="item-card__disc-bar"></view>
          <view class="item-card__disc-bar item-card__disc-bar--vertical"></view>
        </view>
      </view>
    </view>
    <text wx:else class="item-card__completed">{{item.quantityText}}</text>
  </view>
  <button wx:if="{{item.isActive}}" class="item-card__more" catchtap="handleMore" hover-class="item-card__more--pressed" aria-label="更多操作"></button>
</view>

.inventory-row {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  min-height: 146rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx 23rpx;
  border: 2rpx solid #dde5e0;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 7rpx 22rpx rgba(23, 59, 49, 0.04);
  transition: opacity 120ms ease, transform 120ms ease;
}

.inventory-row::before {
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 0;
  width: 5rpx;
  border-radius: 0 5rpx 5rpx 0;
  background: #9eb8ad;
  content: "";
}

.inventory-row--danger::before { background: #c76b60; }
.inventory-row--urgent::before,
.inventory-row--warning::before { background: #d29552; }

.inventory-row--pressed {
  opacity: 0.68;
  transform: scale(0.99);
}

.inventory-row__headline,
.inventory-row__details {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.inventory-row__name {
  min-width: 0;
  max-width: 390rpx;
  overflow: hidden;
  color: #173b31;
  font-size: 30rpx;
  font-weight: 650;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inventory-row__remaining {
  flex: 0 0 auto;
  margin-left: 18rpx;
  padding: 7rpx 13rpx;
  border-radius: 18rpx;
  background: #e8f2ed;
  color: #1f5d49;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.25;
}

.inventory-row--danger .inventory-row__remaining {
  background: #f8e9e6;
  color: #b84a3e;
}

.inventory-row--urgent .inventory-row__remaining,
.inventory-row--warning .inventory-row__remaining {
  background: #f7ecdf;
  color: #9d6225;
}

.inventory-row__details {
  align-items: baseline;
  margin-top: 17rpx;
  padding-top: 15rpx;
  border-top: 2rpx solid #edf1ee;
}

.inventory-row__expiry {
  color: #67766f;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 23rpx;
  font-variant-numeric: tabular-nums;
}

.inventory-row__category {
  margin-left: 18rpx;
  color: #84918b;
  font-size: 22rpx;
}

@media (max-width: 340px) {
  .inventory-row { padding-right: 22rpx; padding-left: 22rpx; }
  .inventory-row__name { max-width: 310rpx; }
  .inventory-row__remaining { margin-left: 12rpx; }
}

.inventory-row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #dde5e0;
  background: transparent;
  transition: opacity 120ms ease;
}

.inventory-row--pressed {
  opacity: 0.58;
}

.inventory-row__date {
  display: flex;
  flex: 0 0 82rpx;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  height: 76rpx;
  margin-right: 22rpx;
  border: 0;
  border-radius: 12rpx 12rpx 10rpx 10rpx;
  background: #e8f2ed;
  text-align: center;
}

.inventory-row__date--danger {
  background: #f8e9e6;
}

.inventory-row__date--urgent,
.inventory-row__date--warning {
  background: #f7ecdf;
}

.inventory-row__month {
  color: #66766f;
  font-size: 18rpx;
  line-height: 1.1;
  letter-spacing: 0.04em;
}

.inventory-row__day {
  margin-top: 3rpx;
  color: #173b31;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.inventory-row__date--danger .inventory-row__day {
  color: #b84a3e;
}

.inventory-row__date--urgent .inventory-row__day,
.inventory-row__date--warning .inventory-row__day {
  color: #a96524;
}

.inventory-row__content {
  min-width: 0;
  flex: 1;
}

.inventory-row__headline {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.inventory-row__name {
  max-width: 294rpx;
  overflow: hidden;
  color: #173b31;
  font-size: 30rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inventory-row__quantity {
  margin-left: 12rpx;
  color: #68766f;
  font-size: 23rpx;
}

.inventory-row__meta {
  display: block;
  margin-top: 7rpx;
  color: #7a8781;
  font-size: 23rpx;
}

.inventory-row__trailing {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 164rpx;
  margin-left: 14rpx;
}

.inventory-row__chevron {
  position: relative;
  display: inline-block;
  box-sizing: border-box;
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
  color: #a3afa9;
}

.inventory-row__chevron::before {
  position: absolute;
  top: 6rpx;
  left: 5rpx;
  box-sizing: border-box;
  width: 10rpx;
  height: 10rpx;
  border-right: 2rpx solid currentColor;
  border-bottom: 2rpx solid currentColor;
  content: "";
  transform: rotate(-45deg);
}

.inventory-row__history-status {
  color: #5f6f68;
  font-size: 24rpx;
  font-weight: 600;
}

.inventory-row--history .inventory-row__date {
  opacity: 0.74;
}

@media (max-width: 340px) {
  .inventory-row__trailing {
    min-width: 146rpx;
  }

  .inventory-row__name {
    max-width: 250rpx;
  }
}

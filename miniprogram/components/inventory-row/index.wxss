.item-card {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  margin-bottom: 18rpx;
  border: 2rpx solid #e3eae6;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(23, 59, 49, 0.05);
  transition: opacity 120ms ease, transform 120ms ease;
}

.item-card::before {
  position: absolute;
  top: 22rpx;
  bottom: 22rpx;
  left: 0;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: #9eb8ad;
  content: "";
}

.item-card--danger::before { background: #c76b60; }
.item-card--urgent::before,
.item-card--warning::before { background: #d29552; }

.item-card--pressed {
  opacity: 0.7;
  transform: scale(0.99);
}

.item-card__body {
  padding: 24rpx 26rpx 20rpx 32rpx;
}

.item-card__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  min-width: 0;
}

.item-card__name {
  min-width: 0;
  max-width: 400rpx;
  overflow: hidden;
  color: #173b31;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-card__remaining {
  flex: 0 0 auto;
  margin-left: 18rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #e8f2ed;
  color: #1f5d49;
  font-size: 21rpx;
  font-weight: 650;
}

.item-card--danger .item-card__remaining {
  background: #f8e9e6;
  color: #b84a3e;
}

.item-card--urgent .item-card__remaining,
.item-card--warning .item-card__remaining {
  background: #f7ecdf;
  color: #9d6225;
}

.item-card__meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.item-card__tag {
  margin-right: 10rpx;
  padding: 5rpx 12rpx;
  border-radius: 8rpx;
  background: #f2f6f4;
  color: #53645d;
  font-size: 21rpx;
  line-height: 1.5;
}

.item-card__tag--quantity {
  background: #e8f2ed;
  color: #1f5d49;
  font-weight: 650;
}

.item-card__tag--muted {
  background: transparent;
  padding-left: 0;
  color: #93a099;
}

.item-card__actions {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 0 16rpx;
  border-top: 2rpx solid #eef2f0;
  background: #fbfdfc;
}

.item-card__action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 116rpx;
  height: 82rpx;
  margin: 0;
  padding: 0 18rpx;
  background: transparent;
}

.item-card__action-text {
  color: #1f5d49;
  font-size: 25rpx;
  font-weight: 600;
}

.item-card__action--more {
  min-width: 96rpx;
  margin-left: auto;
  padding: 0 20rpx;
}

.item-card__dots {
  color: #6b7a73;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1;
}

.item-card__action--pressed {
  opacity: 0.6;
}

@media (max-width: 340px) {
  .item-card__body { padding-right: 20rpx; }
  .item-card__name { max-width: 300rpx; }
  .item-card__action { min-width: 96rpx; padding: 0 12rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .item-card { transition: none; }
}

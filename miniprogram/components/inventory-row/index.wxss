button { margin: 0; padding: 0; background: transparent; line-height: normal; }
button::after { border: 0; }
.item-card { position: relative; display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; min-height: 164rpx; margin-bottom: 16rpx; padding: 20rpx 76rpx 20rpx 18rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 36rpx rgba(48,104,81,.045); }
.item-card--pressed { opacity: .8; }
.item-card__image { flex: 0 0 122rpx; width: 122rpx; height: 126rpx; border-radius: 18rpx; }
.item-card__body { flex: 1; min-width: 0; }
.item-card__name { display: block; overflow: hidden; color: #182c36; font-size: 30rpx; font-weight: 700; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.item-card__meta { display: flex; align-items: center; gap: 22rpx; margin-top: 12rpx; overflow: hidden; }
.item-card__meta-item { display: flex; align-items: center; gap: 8rpx; min-width: 0; }
.item-card__meta-item--category { flex-shrink: 0; color: #206f58; }
.item-card__meta-item--location { flex: 0 1 auto; color: #5088b9; }
.item-card__meta-text { overflow: hidden; font-size: 21rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.meta-icon { flex: 0 0 auto; }
.meta-icon--tag { position: relative; box-sizing: border-box; width: 15rpx; height: 15rpx; border: 2rpx solid currentColor; border-radius: 4rpx; transform: rotate(45deg); }
.meta-icon--tag::after { position: absolute; top: 2rpx; left: 2rpx; width: 5rpx; height: 5rpx; border-radius: 50%; background: currentColor; content: ''; }
.meta-icon--pin { position: relative; box-sizing: border-box; width: 18rpx; height: 22rpx; }
.meta-icon--pin::before { position: absolute; top: 0; left: 2rpx; box-sizing: border-box; width: 14rpx; height: 14rpx; border: 2rpx solid currentColor; border-radius: 50%; content: ''; }
.meta-icon--pin::after { position: absolute; bottom: 1rpx; left: 50%; box-sizing: border-box; width: 9rpx; height: 9rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ''; transform: translateX(-50%) rotate(45deg); }
.item-card__side { flex: 0 0 172rpx; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.item-card__remaining { display: flex; align-items: center; justify-content: center; gap: 8rpx; box-sizing: border-box; min-height: 42rpx; max-width: 100%; padding: 6rpx 12rpx; border-radius: 30rpx; background: #eaf7e7; color: #27823a; font-size: 21rpx; font-weight: 600; white-space: nowrap; }
.item-card__remaining text { overflow: hidden; min-width: 0; text-overflow: ellipsis; }
.item-card--urgent .item-card__remaining, .item-card--warning .item-card__remaining { background: #fff2df; color: #df810d; }
.item-card--danger .item-card__remaining { background: #fff0ef; color: #d45150; font-size: 19rpx; }
.item-card--muted .item-card__remaining { background: #eef3f7; color: #81929d; }
.clock-icon { position: relative; box-sizing: border-box; flex: 0 0 21rpx; width: 21rpx; height: 21rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.clock-icon::after { position: absolute; top: 3rpx; left: 8rpx; width: 5rpx; height: 7rpx; border-left: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ''; }
.item-card__stepper { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 64rpx; }
.item-card__step { position: relative; flex: 0 0 64rpx; width: 64rpx; height: 64rpx; }
.item-card__step::after { position: absolute; top: 8rpx; left: 8rpx; box-sizing: border-box; width: 48rpx; height: 48rpx; border: 1rpx solid #e5ebed; border-radius: 50%; background: #f3f6f7; color: #30434e; font-size: 34rpx; line-height: 46rpx; text-align: center; content: ''; }
.item-card__step--minus::after { content: '−'; }
.item-card__step--plus::after { content: '＋'; font-size: 28rpx; }
.item-card__step--pressed::after { background: #e7edee; border-color: #dbe3e5; }
.item-card__step[disabled]::after { color: #b6c1c6; background: #f7f9f9; border-color: #edf1f2; }
.item-card__quantity { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; min-width: 0; min-height: 64rpx; color: #1b303a; font-size: 27rpx; font-weight: 600; line-height: 1.25; }
.item-card__quantity text { color: #8b999f; font-size: 16rpx; font-weight: 400; }
.item-card__completed { color: #82929a; font-size: 24rpx; }
.item-card__more { position: absolute; top: 10rpx; right: 14rpx; width: 56rpx; height: 56rpx; }
.item-card__more::after { position: absolute; top: 50%; left: 50%; width: 6rpx; height: 6rpx; border-radius: 50%; background: #7d8c94; box-shadow: -12rpx 0 0 #7d8c94, 12rpx 0 0 #7d8c94; content: ''; transform: translate(-50%, -50%); }
.item-card__more--pressed::after { background: #a9b5bb; box-shadow: -12rpx 0 0 #a9b5bb, 12rpx 0 0 #a9b5bb; }
@media (max-width: 350px) { .item-card { gap: 12rpx; padding-left: 14rpx; padding-right: 74rpx; } .item-card__image { flex-basis: 104rpx; width: 104rpx; height: 118rpx; } .item-card__name { font-size: 28rpx; } .item-card__meta { gap: 14rpx; } }

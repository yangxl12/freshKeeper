button { margin: 0; padding: 0; background: transparent; line-height: normal; }
button::after { border: 0; }
.item-card { position: relative; display: flex; align-items: center; gap: 20rpx; box-sizing: border-box; min-height: 164rpx; margin-bottom: 16rpx; padding: 20rpx 64rpx 20rpx 18rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 10rpx 36rpx rgba(48,104,81,.045); }
.item-card--pressed { opacity: .8; }
.item-card__image { flex: 0 0 122rpx; width: 122rpx; height: 126rpx; border-radius: 18rpx; }
.item-card__body { flex: 1; min-width: 0; }
.item-card__name { display: block; overflow: hidden; color: #182c36; font-size: 30rpx; font-weight: 700; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.item-card__meta { display: flex; gap: 8rpx; margin-top: 10rpx; overflow: hidden; }
.item-card__tag { flex-shrink: 0; padding: 3rpx 12rpx; border-radius: 18rpx; background: #e6f7f0; color: #206f58; font-size: 20rpx; line-height: 1.5; }
.item-card__tag--storage { flex-shrink: 1; overflow: hidden; background: #edf5ff; color: #5088b9; text-overflow: ellipsis; white-space: nowrap; }
.item-card__location { display: flex; align-items: center; gap: 9rpx; margin-top: 12rpx; color: #89959c; font-size: 20rpx; }
.item-card__location text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.location-pin { position: relative; flex: 0 0 14rpx; height: 18rpx; border-radius: 12rpx 12rpx 12rpx 0; background: #9ca8ae; transform: rotate(-45deg); }
.location-pin::after { position: absolute; top: 5rpx; left: 4rpx; width: 6rpx; height: 6rpx; border-radius: 50%; background: white; content: ''; }
.item-card__side { flex: 0 0 172rpx; display: flex; flex-direction: column; align-items: center; gap: 24rpx; }
.item-card__remaining { display: flex; align-items: center; justify-content: center; gap: 8rpx; box-sizing: border-box; min-height: 42rpx; max-width: 190rpx; padding: 6rpx 12rpx; border-radius: 30rpx; background: #eaf7e7; color: #27823a; font-size: 21rpx; font-weight: 600; white-space: nowrap; }
.item-card--urgent .item-card__remaining, .item-card--warning .item-card__remaining { background: #fff2df; color: #df810d; }
.item-card--danger .item-card__remaining { background: #fff0ef; color: #d45150; font-size: 19rpx; }
.item-card--muted .item-card__remaining { background: #eef3f7; color: #81929d; }
.clock-icon { position: relative; box-sizing: border-box; flex: 0 0 21rpx; width: 21rpx; height: 21rpx; border: 2rpx solid currentColor; border-radius: 50%; }
.clock-icon::after { position: absolute; top: 3rpx; left: 8rpx; width: 5rpx; height: 7rpx; border-left: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; content: ''; }
.item-card__stepper { display: flex; align-items: center; width: 100%; justify-content: space-between; }
.item-card__step { display: flex; align-items: center; justify-content: center; flex: 0 0 48rpx; width: 48rpx; height: 48rpx; border: 1rpx solid #e5ebed; border-radius: 50%; background: #f3f6f7; color: #30434e; font-size: 34rpx; }
.item-card__step[disabled] { color: #b6c1c6; }
.item-card__quantity { flex: 1; min-width: 0; color: #1b303a; font-size: 27rpx; font-weight: 600; }
.item-card__quantity text { display: block; color: #8b999f; font-size: 16rpx; font-weight: 400; }
.item-card__completed { color: #82929a; font-size: 24rpx; }
.item-card__more { position: absolute; top: 16rpx; right: 7rpx; width: 54rpx; height: 54rpx; color: #7d8c94; font-size: 35rpx; font-weight: 700; letter-spacing: 2rpx; }
@media (max-width: 350px) { .item-card { gap: 12rpx; padding-left: 14rpx; padding-right: 54rpx; } .item-card__image { flex-basis: 104rpx; width: 104rpx; height: 118rpx; } .item-card__name { font-size: 28rpx; } }

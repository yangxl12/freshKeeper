.inventory-row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #e4eae6;
  background: transparent;
  transition: opacity 120ms ease;
}

.inventory-row--pressed {
  opacity: 0.58;
}

.inventory-row__date {
  display: flex;
  flex: 0 0 78rpx;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  height: 78rpx;
  margin-right: 22rpx;
  border: 2rpx solid #cbd7d1;
  border-radius: 12rpx;
  background: #fbfcfa;
  text-align: center;
}

.inventory-row__month {
  color: #718079;
  font-size: 18rpx;
  line-height: 1.1;
  letter-spacing: 0.04em;
}

.inventory-row__day {
  margin-top: 3rpx;
  color: #18342d;
  font-family: "DIN Alternate", "Arial Narrow", sans-serif;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}

.inventory-row__content {
  min-width: 0;
  flex: 1;
}

.inventory-row__headline {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.inventory-row__name {
  max-width: 300rpx;
  overflow: hidden;
  color: #18342d;
  font-size: 30rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inventory-row__quantity {
  margin-left: 12rpx;
  color: #68766f;
  font-size: 23rpx;
}

.inventory-row__meta {
  display: block;
  margin-top: 7rpx;
  color: #7a8781;
  font-size: 23rpx;
}

.inventory-row__trailing {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 170rpx;
  margin-left: 14rpx;
}

.inventory-row__chevron {
  margin-left: 12rpx;
  color: #a5b0ab;
  font-size: 40rpx;
  font-weight: 300;
}

.inventory-row__history-status {
  color: #5f6f68;
  font-size: 24rpx;
  font-weight: 600;
}

.inventory-row--history .inventory-row__date {
  opacity: 0.74;
}

.status {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 12rpx;
  border-radius: 22rpx;
  background: #e8f2ed;
  color: #52615b;
  font-size: 22rpx;
  font-weight: 600;
}

.status--danger {
  background: #f8e9e6;
  color: #b84a3e;
}

.status--urgent {
  background: #f7ecdf;
  color: #a96524;
}

.status--warning {
  background: #f7ecdf;
  color: #96611f;
}

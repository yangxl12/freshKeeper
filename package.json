{
  "name": "fresh-keeper",
  "version": "0.1.0",
  "private": true,
  "description": "保质期助手微信小程序",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:project": "node scripts/validate-project.mjs",
    "check:mcp": "node scripts/start-wechat-devtools-mcp.mjs --check",
    "check": "npm run typecheck && npm test && npm run check:project"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "miniprogram-api-typings": "5.2.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
